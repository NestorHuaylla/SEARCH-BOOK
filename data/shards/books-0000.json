rg/details/mitre_historiadesanmartinydelaemancipacionsud-americana_v_1_1903","language":"es","formats":[{"type":"pdf","url":"https://archive.org/download/mitre_historiadesanmartinydelaemancipacionsud-americana_v_1_1903/Mitre%20Historia%20de%20San%20Martin%20y%20de%20la%20emancipacion%20sudamericana%20v%201.pdf"},{"type":"epub","url":"https://archive.org/download/mitre_historiadesanmartinydelaemancipacionsud-americana_v_1_1903/Mitre%20Historia%20de%20San%20Martin%20y%20de%20la%20emancipacion%20sudamericana%20v%201.epub"},{"type":"html","url":"https://archive.org/download/mitre_historiadesanmartinydelaemancipacionsud-americana_v_1_1903/Mitre%20Historia%20de%20San%20Martin%20y%20de%20la%20emancipacion%20sudamericana%20v%201_hocr.html"},{"type":"text","url":"https://archive.org/download/mitre_historiadesanmartinydelaemancipacionsud-americana_v_1_1903/Mitre%20Historia%20de%20San%20Martin%20y%20de%20la%20emancipacion%20sudamericana%20v%201_djvu.txt"}],"access":"creative_commons","license":"http://creativecommons.org/publicdomain/mark/1.0/","verified_legal":true}]},{"id":"work:be78aa1a3dee3f2c608e185e","title":"Historia local y Ciencias Sociales: fundamentos teórico-metodológicos para su enseñanza","subtitle":"","description":"This work addresses the need to transform the teaching of Social Sciences, overcoming traditional curricula that limit critical thinking and student participation. In today’s knowledge-based society, the prevalence of lectures and student passivity contrast with the urgent need for approaches that foster leadership and the active construction of knowledge. Local history is presented as an essential pedagogical proposal to overcome these limitations. By connecting students with their immediate environment, it promotes meaningful and active learning, engaging both teachers and students. However, a gap has been identified in Social Sciences curricula regarding the local context, which impedes the construction of identity and the recognition of the indigenous. This approach seeks to fill this gap by highlighting the relevance of local history for the development of critical thinking and a deep understanding of society, promoting a more relevant and contextualized education.","authors":["Calvas-Ojeda, María Gabriela"],"language":"es","year":2025,"publisher":"Sophia Editions","isbn":[],"doi":"10.64092/duzx5312","subjects":["Ciencias Sociales","Historia local","Pensamiento crítico","Aprendizaje significativo","Currículo contextualizado","thema EDItEUR::N History and Archaeology::NH History"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/178520.2","cover_url":"https://directory.doabooks.org/rest/bitstreams/a3a750df-7ca4-4e87-b94b-2e1c5e150053/retrieve","formats":[],"access":"open_access","license":"Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/178520.2","handle":"20.500.12854/178520.2","dspace_uuid":"4a822f93-3331-4590-bc33-78df80e65dfd"},"providers":[{"source":"DOAB","source_id":"20.500.12854/178520.2","source_url":"https://directory.doabooks.org/handle/20.500.12854/178520.2","language":"es","formats":[],"access":"open_access","license":"Other open license","verified_legal":true}]},{"id":"work:2ab975622d5d1cacf2fa69cd","title":"History and Theory of Compromise","subtitle":"","description":"Interest in compromise has recently grown both in public and scholarly debates. However, there is a lack of interdisciplinary dialogue on the topic. This volume fills this gap by bringing together contributions from various relevant disciplines. They show that compromise has been a central technique to regulate social and political conflicts in different contexts. In a compromise the conflicting parties create an agreement by making mutual concessions, but do not give up their original claims. Therein lies the capacity of compromise to prevent or end escalated conflicts even in situations in which disagreements cannot be transformed into a consensus. In addition to theoretical investigations of the concept, the volume includes case studies on Europe in the Middle Ages, in the 19th and 20th centuries, and on pre-modern and contemporary Japan. The overarching question is about the preconditions of compromises. The authors examine the role of compromise in diplomacy, politics, trade, economics, and everyday life. Together they generate a comprehensive picture of the capacities and limitations of compromise in the past and today.","authors":[],"language":"en","year":2025,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Politics","History","Culture","Conflict resolution_x000D_","Geschichtswissenschaften","Konflikte","Kulturwissenschaft","Politikwissenschaften","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism::DSB Literary studies: general","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism","thema EDItEUR::J Society and Social Sciences::JP Politics and government::JPA Political science and theory"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/181468","cover_url":"https://directory.doabooks.org/rest/bitstreams/9ff0f351-e60d-4746-8fe5-147135b44845/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116696/1/9783111701462.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by-sa/4.0/ · CC-BY-SA","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/181468","handle":"20.500.12854/181468","dspace_uuid":"a3b99787-31c5-45b8-9528-3f53d1dbb4f2"},"providers":[{"source":"DOAB","source_id":"20.500.12854/181468","source_url":"https://directory.doabooks.org/handle/20.500.12854/181468","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116696/1/9783111701462.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by-sa/4.0/ · CC-BY-SA","verified_legal":true}]},{"id":"work:c27b8720c1d3d0e9cf7b73fe","title":"History of Intellectual Culture 4/2025","subtitle":"Gender, Archiving, and Knowledge Production after the Holocaust. A Postwar Republic of Letters?","description":"The fourth issue of the yearbook History of Intellectual Culture (HIC) features a thematic section on the production of knowledge related to the Holocaust. The contributions focus on the circulation of knowledge via letters and other forms of written communication within and among survivor historical commissions after the Second World War with an emphasis on the interplay of gender and other differences. Although more women than men were involved in these efforts, women typically held subordinate roles to men and have largely been invisible in the historiography of these endeavors. This thematic section addresses this lacuna by exploring aspects of the “unseen labor” behind these documentation efforts that remain underexplored and marginalized in studies on the production, circulation, and history of knowledge, as well as of intellectual culture.","authors":[],"language":"en","year":2025,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["History of knowledge","Holocaust","Postwar period (Second World War)","Nachkriegszeit (2. Weltkrieg)","Wissensgeschichte","thema EDItEUR::N History and Archaeology::NH History","thema EDItEUR::N History and Archaeology::NH History::NHB General and world history"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116830","cover_url":"https://library.oapen.org/rest/bitstreams/e658ff89-206a-4a91-8653-21bd6225d1bb/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/5bec1e6a-6f40-4651-83f8-62845a77ae45/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116830","handle":"20.500.12657/116830","dspace_uuid":"32bce6b9-952a-47b6-9b72-0b3239f0550e"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116830","source_url":"https://library.oapen.org/handle/20.500.12657/116830","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/5bec1e6a-6f40-4651-83f8-62845a77ae45/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true}]},{"id":"work:89b03b7f1a97aa9c1cefd87f","title":"History of Tom Jones, a Foundling","subtitle":"","description":"","authors":["Fielding, Henry"],"language":"en","year":null,"publisher":"Project Gutenberg","isbn":[],"doi":"","subjects":["Bildungsromans","England -- Fiction","Foundlings -- Fiction","Humorous stories","Identity (Psychology) -- Fiction","Young men -- Fiction","Banned Books from Anne Haight's list","Best Books Ever Listings","Category: British Literature","Category: Classics of Literature","Category: Novels","Harvard Classics","Movie Books"],"source":"Project Gutenberg","source_url":"https://www.gutenberg.org/ebooks/6593","cover_url":"https://www.gutenberg.org/cache/epub/6593/pg6593.cover.medium.jpg","formats":[{"type":"html","url":"https://www.gutenberg.org/ebooks/6593.html.images"},{"type":"epub","url":"https://www.gutenberg.org/ebooks/6593.epub3.images"},{"type":"mobi","url":"https://www.gutenberg.org/ebooks/6593.kf8.images"},{"type":"text","url":"https://www.gutenberg.org/ebooks/6593.txt.utf-8"}],"access":"public_domain","license":"Public domain in the United States","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"6593","gutenberg_id":"6593"},"providers":[{"source":"Project Gutenberg","source_id":"6593","source_url":"https://www.gutenberg.org/ebooks/6593","language":"en","formats":[{"type":"html","url":"https://www.gutenberg.org/ebooks/6593.html.images"},{"type":"epub","