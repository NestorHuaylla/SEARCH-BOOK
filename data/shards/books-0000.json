38321986","2266182714","6073807864","9788492966813","9798212980005","1407132105","9786050930665","9788499305431","9781410428417","9789000331994","9788413144870","1546171886","9000331994","9862132167","9789655522006","9798855026160","8427248482","1743629877","9781742835778","0606351337","1536425524","9788184776218","9786054263868","0439023548","9789000343027","9781743629871","8427202148","8492966815","0545791901","9781407153353","9781407139814","8499328059","9781407109374","8427200382","0545788293","8413144876","1407109375","9351035980","0545101425","8935235200067","6555321466","8372784914","8372789800","9788804716716","1407133195","9781407191317","9780606264495","9789351035985","9788372789808","9788427208414","8427208413","1484418247","900034302X","9782266182713","9780702342400","9788427202146","9781407192253","9953879850","981086874X","9788579800863","9781536425529","9781407136202","9781407133195","2266260790","8380081536","1407191314","9781713586371","9785271424557","9782266257992","9788427248489","0545317800","9780439023511","7506358026","6054263862","9789876092449","605093066X","9783841501363","9780439023542","9798212982122","9787506358026","0606264493","0702342408","9788380081536","1407192256","9786073807869","070233300X","8499305431","9788804632245","9781407129013","9782266260794","9655522008","1407155768","9788499328058","9789953879857","8804716711","1407129023","9786046983569","8804632240","9781407132105","1407157884","1407153358","5271424553","0545796687","849932309X","9786180122794","9788499323091","2266257994","8579800862","0545663261","8184776217","159413586X","9780702333002","9781484418246","1742835775","9789810868741","0545310601","0439023513","9781407188928","9781546171881","6046983568","9783789132209","9780545101424","9781407129020","9788427200388","9789722346535","1410428419","9781594135866","6180122792","9780545663267","9780545310604","1407188925","9722346539","9788467240870","9876092448","3789132209","9780545791908","1407139819","9798225029760","9781338321982","9780545788298","9781407155760","9786555321463","1713586371","9780545796682","9781743628836","8467240873","9789862132166","1407129015"],"doi":"","subjects":[],"source":"Open Library","source_url":"https://openlibrary.org/works/OL14908941W","cover_url":"https://covers.openlibrary.org/b/id/12646459-M.jpg","formats":[],"access":"digital_lending","license":"","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"OL14908941W","openlibrary_work":"OL14908941W","openlibrary_edition":"OL57728017M","internet_archive":"ziyouhuanmeng0000coll"},"providers":[{"source":"Open Library","source_id":"OL14908941W","source_url":"https://openlibrary.org/works/OL14908941W","language":"und","formats":[],"access":"digital_lending","license":"","verified_legal":true}]},{"id":"work:7bb9b0f6bb3937709703019c","title":"Modellgestützte Analyse eines an die deutsche Energiewirtschaft angepassten lokalen Energiemarktes mit integriertem Engpassmanagement","subtitle":"","description":"Durch die Energiewende wird das Energiesystem zunehmend dezentraler und kleinteiliger. Prosumenten installieren dezentrale Energiesysteme wie Ladeinfrastruktur und Photovoltaikanlagen, denen ein träges Stromnetz gegenübersteht, welches diese Systeme vermehrt nicht aufnehmen kann. Dadurch gewinnt das Engpassmanagement auch in den unteren Spannungsebenen des Stromnetzes zunehmend an Bedeutung und wird immer komplexer und umfassender. Hieraus entstehen hohe Kosten für den Ausbau der Stromnetze. Diese Kosten lassen auch die Netzentgelte steigen, was Prosumenten dazu anregt, immer mehr auf Eigenverbrauch zu setzen. Dieser Eigenverbrauch senkt die Stromkosten, ohne notwendigerweise die Spitzenleistung zu senken und damit das Netz zu entlasten. Somit wird die Chance vertan, mittels Synthese aus Eigenverbrauchsmodellen, dynamischen Tarifen, variablen Netzentgelten und dem Ausbau der intelligenten Messsysteme die Prosumenten zur Reduktion des Netzausbaubedarfs anzureizen. Durch richtig konfigurierte lokale Märkte könnte die Flexibilität der Prosumenten zur effizienten Allokation und Dimensionierung der Stromnetze eingesetzt werden. Um dies zu demonstrieren, wird in dieser Arbeit ein lokaler Energiemarkt konzipiert, der auf einem Peer-to-Peer-Handel basiert und gleichzeitig eine effizientere Allokation der Stromnetze ermöglicht. Dieser Markt wird im Gegensatz zu vergleichbaren Arbeiten auf Basis bestehender Marktprozesse und Regulierungen abgeleitet. Mittels modellgestützter Analysen kann gezeigt werden, dass dadurch nicht nur die Stromkosten für die Prosumenten sinken, sondern auch zusätzliche zielgerichtete Investitionsanreize zur Flexibilisierung entstehen. Das integrierte Engpassmanagement führt insgesamt zu einer effizienteren Allokation des Stromnetzes und damit zu einem geringeren Ausbaubedarf.","authors":["Teske, Franz"],"language":"de","year":2026,"publisher":"FAU University Press","isbn":[],"doi":"10.25593/978-3-96147-920-7","subjects":["Strommarkt","Stromsystem","Engpassmanagement","Stromnetz","thema EDItEUR::K Economics, Finance, Business and Management::KN Industry and industrial studies::KNB Energy industries and utilities","thema EDItEUR::T Technology, Engineering, Agriculture, Industrial processes::TH Energy technology and engineering::THY Energy, power generation, distribution and storage","thema EDItEUR::T Technology, Engineering, Agriculture, Industrial processes::TH Energy technology and engineering::THR Electrical engineering"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116951","cover_url":"https://library.oapen.org/rest/bitstreams/95856a38-77ff-483f-b7f0-f4dd80ddcdfe/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/b286cfcc-a8eb-4515-986d-4cfa218bea7a/retrieve"},{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116951/1/9783961479207.pdf"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc/4.0/ · CC-BY-NC · Ot