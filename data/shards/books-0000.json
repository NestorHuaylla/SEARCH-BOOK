txt.utf-8"},{"type":"text","url":"https://www.gutenberg.org/files/8197/8197-0.txt"}],"access":"public_domain","license":"Public domain in the United States","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"8197","gutenberg_id":"8197"},"providers":[{"source":"Project Gutenberg","source_id":"8197","source_url":"https://www.gutenberg.org/ebooks/8197","language":"en","formats":[{"type":"html","url":"https://www.gutenberg.org/ebooks/8197.html.images"},{"type":"epub","url":"https://www.gutenberg.org/ebooks/8197.epub3.images"},{"type":"mobi","url":"https://www.gutenberg.org/ebooks/8197.kf8.images"},{"type":"text","url":"https://www.gutenberg.org/ebooks/8197.txt.utf-8"},{"type":"text","url":"https://www.gutenberg.org/files/8197/8197-0.txt"}],"access":"public_domain","license":"Public domain in the United States","verified_legal":true}]},{"id":"work:a4816e02ed514b5016086b8d","title":"Indigenous and Minority Placenames","subtitle":"Australian and International Perspectives","description":"This book showcases current research into Indigenous and minority placenames in Australia and internationally. Many of the chapters in this volume originated as papers at a Trends in Toponymy conference hosted by the University of Ballarat in 2007 that featured Australian and international speakers. The chapters in this volume provide insight into the quality of toponymic research that is being undertaken in Australia and in countries such as Canada, Finland, South Africa, New Zealand, and Norway. The research presented here draws on the disciplines of linguistics, geography, history, and anthropology. The book includes meticulous studies of placenames in central NSW and the Upper Hunter region; Gundungurra cave names; western Arnhem Land; Northern Cape York Peninsula and Mount Wheeler in Queensland; saltwater placenames around Mer in the Torres Strait; and the Kaurna in South Australia.","authors":[],"language":"en","year":2014,"publisher":"ANU Press","isbn":[],"doi":"","subjects":["Indigenous placenames","Indigenous place names","Minority placenames","Indigenous Australia","Toponymy","Linguistics","Anthropology","History","Geography","thema EDItEUR::R Earth Sciences, Geography, Environment, Planning::RG Geography::RGX Geographical reference works::RGXP Place names and gazetteers","thema EDItEUR::C Language and Linguistics::CF Linguistics","thema EDItEUR::J Society and Social Sciences::JH Sociology and anthropology","thema EDItEUR::N History and Archaeology::NH History::NHM Australasian and Pacific history","thema EDItEUR::C Language and Linguistics::CF Linguistics::CFF Historical and comparative linguistics"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116547","cover_url":"https://library.oapen.org/rest/bitstreams/e4d33547-6eb6-4ee8-929c-3a574308c559/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/d9d95e25-49b4-45d8-b028-764797c232e1/retrieve"}],"access":"open_access","license":"Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116547","handle":"20.500.12657/116547","dspace_uuid":"de93c1e4-470d-40c6-898a-24371cfd970c"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116547","source_url":"https://library.oapen.org/handle/20.500.12657/116547","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/d9d95e25-49b4-45d8-b028-764797c232e1/retrieve"}],"access":"open_access","license":"Other open license","verified_legal":true}]},{"id":"work:64c5456b26fc417a5061bcfe","title":"Indonesian Journal of Electrical Engineering and Computer Science","subtitle":"","description":"","authors":["Mayyadah R. Mahmood","Maiwan B. Abdulrazzaq","Subhi R. M. Zeebaree","Abbas Ibrahim","Rizgar R. Zebari","Hivi Ismat Dino"],"language":"en","year":2025,"publisher":"Indonesian Journal of Electrical Engineering and Computer Science","isbn":[],"doi":"10.11591/ijeecs","subjects":["Advanced Image and Video Retrieval Techniques","Metaheuristic Optimization Algorithms Research","Algorithms and Data Compression"],"source":"OpenAlex","source_url":"https://doi.org/10.11591/ijeecs","cover_url":"","formats":[],"access":"creative_commons","license":"CC BY","verified_legal":true,"resource_type":"article","identifiers":{"source_id":"W4295314730","openalex_id":"W4295314730"},"providers":[{"source":"OpenAlex","source_id":"W4295314730","source_url":"https://doi.org/10.11591/ijeecs","language":"en","formats":[],"access":"creative_commons","license":"CC BY","verified_legal":true}]},{"id":"work:a7bc1a5cadf5eb51adccfcc4","title":"Industry 4.0 dislocations in small and medium enterprises: A supply chain management view","subtitle":"","description":"Small and medium enterprises (SMEs) are widely acknowledged for their contribution to economic growth and development and continue to draw sustained interest from policymakers and academics. Despite their importance, SMEs remain vulnerable to major shocks and rapid technological change, particularly the advancements associated with Industry 4.0 (also referred to as the Fourth Industrial Revolution). Many SMEs lack the financial and technical capacity to assess, adopt and integrate these emerging technologies effectively. This book addresses these challenges by demonstrating how SMEs can leverage supply chains as a strategic source of resilience, competitive advantage and technological adaptation. It argues that embedding SMEs within the supply chains in which they operate is essential for navigating the complex technology landscape of Industry 4.0. Instead of viewing themselves as passive observers of technological disruption, SMEs should recognise their potential to become active participants – and even leaders – in increasingly digital supply chain ecosystems. The book consists of 10 chapters of original scholarly work, covering themes such as intelligent manufacturing (IM), blockchain technology (BCT), augmented and virtual reality, digital supply chain transformation and SME resilience. It is one of the few works that integrates the often siloed discussions of Industry 4.0, supply chain dynamics and SME development.","authors":["Masakale, Dr Dingi","Munongo, Shallone","Munyanyi, Watson"],"language":"en","year":2026,"publisher":"AOSIS","isbn":[],"doi":"10.4102/aosis.2026.bk572","subjects":["4IR","SME's","Supply chains","Supply chain management","Intelligent manufacturing","Smart factories","Block chain technology","Digital supply chains","SME resilience","Industry 4.0","Small and medium enterprises","Small and medium enterprise resilience","Small businesses and self-employment","Industry and industrial studies","Distribution and logistics management","Addictive manufacturing","Artificial intelligence technologies","Blockchain ecosystem","Data transparency and security","Digital supply chain strategy implementation","Digital supply chain strategy","First Industrial Revolution","Fourth Industrial Revolution","Industrial revolutions","Modern cryptography","Second Industrial Revolution","Technology adoption","Intelligent factories","thema EDItEUR::K Economics, Finance, Business and Management::KJ Business and Management::KJM Management and management techniques::KJMV Management of specific areas::KJMV9 Distribution and logistics management","thema EDItEUR::K Economics, Finance, Business and Management::KN Industry and industrial studies","thema EDItEUR::K Economics, Finance, Business and Management::KJ Business and Management::KJV Ownership and organization of enterprises::KJVS Small businesses and self-employment"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/117045","cover_url":"https://library.oapen.org/rest/bitstreams/2c121a2c-6fc3-45ae-8e33-5ceeb696ad8a/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/f1d35b4f-efb2-478e-964c-e15db2701213/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/117045","handle":"20.500.12657/117045","dspace_uuid":"2e78112a-8b9c-4131-a40f-ae473752fc63"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/117045","source_url":"https://library.oapen.org/handle/20.500.12657/117045","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/f1d35b4f-efb2-478e-964c-e15db2701213/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true}]},{"id":"work:0db6a1f89daf85564d950633","title":"Informal Work in Europe, ca. 1870–1970","subtitle":"","description":"Formalized wage labor is often presented as the focus, if not the very core, of modern European labor history. The current volume challenges this widespread narrative by focusing on multiple forms of informal work in all parts of Europe. The chapters cover key fields of informal labor—agricultural, domestic, temporary, service, and sex work—during the period between 1870 and 1970, which is usually portrayed as an era of labor formalization. By demonstrating that informal work was neither a temporary nor a residual phenomenon, the contributors to this book render it visible as a constitutive factor of labor and labor politics in European history. In doing so, the volume aims to redraw the contours of labor history in nineteenth- and twentieth-century Europe while stimulating further thinking about a de-provincialized global history of work.","authors":["Enbom, Leena","Richter, Jessica","Latorre Manglano, Diego","Boris, Eileen"],"language":"en","year":2026,"publisher":"Central European University Press","isbn":[],"doi":"10.5117/9789048573707","subjects":["Informal work","19th- and 20th-century Europe","Age of labour formalisation","Labour regulation","Global history of work","thema