pe":"html","url":"https://www.gutenberg.org/ebooks/3044.html.images"},{"type":"epub","url":"https://www.gutenberg.org/ebooks/3044.epub3.images"},{"type":"mobi","url":"https://www.gutenberg.org/ebooks/3044.kf8.images"},{"type":"text","url":"https://www.gutenberg.org/ebooks/3044.txt.utf-8"},{"type":"text","url":"https://www.gutenberg.org/files/3044/3044-0.txt"}],"access":"public_domain","license":"Public domain in the United States","verified_legal":true}]},{"id":"work:75943782c55069ab79dd52a3","title":"Destinos","subtitle":"","description":"","authors":["Bill VanPatten","Martha Alford Marks","Richard V. Teschner"],"language":"en","year":1991,"publisher":"McGraw-Hill Humanities/Social Sciences/Languages","isbn":["0070020736","0070672571","9780072390209","9780070020696","0070672482","9780078331367","0078331366","0070672598","0070672601","9780070672482","9780070672277","0070672474","007002071X","0070020698","9780070672598","9780070020726","0072390204","9780070672574","9780070020719","007067227X","9780070672475","9780070672604","9780070020733","0070020728"],"doi":"","subjects":[],"source":"Open Library","source_url":"https://openlibrary.org/works/OL3237184W","cover_url":"https://covers.openlibrary.org/b/id/4944804-M.jpg","formats":[],"access":"digital_lending","license":"","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"OL3237184W","openlibrary_work":"OL3237184W","openlibrary_edition":"OL9251932M","internet_archive":"destinosfacultyg0000bill"},"providers":[{"source":"Open Library","source_id":"OL3237184W","source_url":"https://openlibrary.org/works/OL3237184W","language":"en","formats":[],"access":"digital_lending","license":"","verified_legal":true}]},{"id":"work:0c894f9aa085a34a51aad72b","title":"Deutsch als Minderheitensprache in der Welt","subtitle":"Strukturen – Kontakt – Identitäten","description":"The German Linguistic Studies Series is a comprehensive and outstanding forum in its field. It has borne the name of its subject in its title since the foundation of the series in the eighth decade of the last century. The series is comprehensive in the broad spectrum of topics covered (language levels, varieties, communication forms, epochs) in the range of research perspectives (theoretical and empirical studies, fundamental research and applications, interdisciplinarity with psychology, the social sciences etc.) and methodologies (the sole criterion is quality), in the rhythm of research (trends are perceived and also set, achievements are secured) and in the forms of presentation (monographs, textbooks, collected volumes, dictionaries). Professorial theses, outstanding doctoral theses, pioneering research findings from wider contexts, but also the surprising ‛stroke of genius’ set the standards for inclusion in the series. Call for Book Proposals: https://blog.degruyter.com/call-for-book-proposals-reihe-germanistische-linguistik/","authors":[],"language":"de","year":2025,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["German as a minority language","Contrastive linguistics","Language contact","Corpus linguistics","Deutsch als Minderheitensprache","Kontrastive Linguistik","Sprachkontakt","Korpuslinguistik","thema EDItEUR::C Language and Linguistics::CF Linguistics","thema EDItEUR::C Language and Linguistics::CJ Language teaching and learning","thema EDItEUR::C Language and Linguistics::CF Linguistics::CFF Historical and comparative linguistics"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/181402","cover_url":"https://directory.doabooks.org/rest/bitstreams/76f6c881-2c6c-4578-b5aa-8e328cea60f5/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116738/1/9783112212783.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by/4.0/ · CC-BY","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/181402","handle":"20.500.12854/181402","dspace_uuid":"694fd0df-5e32-4536-9533-29aa5dc38819"},"providers":[{"source":"DOAB","source_id":"20.500.12854/181402","source_url":"https://directory.doabooks.org/handle/20.500.12854/181402","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116738/1/9783112212783.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by/4.0/ · CC-BY","verified_legal":true}]},{"id":"work:5c4fb5e1557c7c1ba398378c","title":"Deutsch diachron übersetzen","subtitle":"Mediävistische, translationswissenschaftliche und linguistische Perspektiven auf das Übersetzen aus dem Mittelhochdeutschen","description":"The series publishes studies and sources on the history of the German language and literature from the beginnings of the tradition in the 8th century to more recent linguistic history. It publishes philologically high-quality linguistic and literary studies and editions, as well as works that deal with aspects of linguistics and literary studies in equal measure. Thematically, the whole range of diachronic and synchronic issues is welcome: Variations and varieties, language change, norm and usage, language criticism, language contact, empiricism and theory, production and reception, manuscripts and prints. Publication formats include monographs as well as edited volumes. The preferred language of publication is German. The LHG is edited by three members of the Gesellschaft für germanistische Sprachgeschichte (GGSG): - Stephan Müller, Professor of Older German Language and Literature at the University of Vienna - Claudia Wich-Reif, Professor of the History of the German Language and Linguistic Variation at the Rheinische Friedrich-Wilhelms-Universität Bonn - Arne Ziegler, Professor of German Language with special emphasis on Historical Linguistics and Variety Linguistics at the Karl-Franzens University of Graz Co-founder and co-editor from 2016-2019 was Jörg Riecke, Professor of German Linguistics with a special focus on language history at Ruprecht-Karls-Universität Heidelberg (+2019)","authors":["Beck, Wolfgang","Runow, Holger","Schindler, Andrea"],"language":"de","year":2025,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Translation","Linguistics","Middle High German","Middle Ages","Linguistik","Mittelalter","Mittelhochdeutsch","Übersetzung","thema EDItEUR::C Language and Linguistics::CF Linguistics::CFP Translation and interpretation","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism::DSB Literary studies: general::DSBB Literary studies: ancient, classical and medieval","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116828","cover_url":"https://library.oapen.org/rest/bitstreams/af46dedd-215e-43e7-830e-2d633304f87c/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/9c6f00ff-3d58-4135-a0fd-efdc446ddf7c/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by/4.0/ · CC-BY · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116828","handle":"20.500.12657/116828","dspace_uuid":"e985add4-d906-462f-b82e-426560d93bc5"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116828","source_url":"https://library.oapen.org/handle/20.500.12657/116828","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/9c6f00ff-3d58-4135-a0fd-efdc446ddf7c/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by/4.0/ · CC-BY · Other open license","verified_legal":true}]},{"id":"work:bb696c44806272aa019e8a7e","title":"Deweaponizing Interdependence","subtitle":"Bringing the Idea of International Clearing Union into the Twenty-First Century","description":"Offering an excellent overview of critical approaches to international payment systems, this open access volume re-introduces the contemporary relevance, origins and aims of the International Clearing Union (ICU), a concept associated with J. M. Keynes and with debates of continued contemporary importance to global political economy. This volume focuses on how ICU proposals interact with economic theory and normative principles of ethics and politics. It examines key contemporary political issues including de-dollarisation, development, overcoming nationalism, principles of fairness in trade and finance, commodity pricing, fixed vs. floating exchange rates, capital controls, the need for planning, and global public investments, as well as urgent issues of climate emergency and ecological breakdown. As such, this important volume provides a wide range of perspectives from both the Global North and Global South, as well as from different disciplines including politics, economics and political theory. ‘ The ebook editions of this book are available open access under a CC BY-NC-ND 4.0 licence on bloomsburycollections.com. Open access was funded by The University of Helsinki.","authors":[],"language":"en","year":2026,"publisher":"Bloomsbury Publishing (UK)","isbn":[],"doi":"","subjects":["Globalisation","Liquidity","Trade","Ethics","Development","Multipolarity","Planning","Sovereignty","Climate","Reform","thema EDItEUR::K Economics, Finance, Business and Management::KC Economics::KCP Political economy","thema EDItEUR::K Economics, Finance, Business and Management::KC Economics::KCB Macroeconomics::KCBM Monetary economics","thema EDItEUR::K Economics, Finance, Business and Management::KC Economics::KCL International economics","thema EDItEUR::K Economics, Finance, Business and Management::KC Economics::KCS Economic systems and structures","thema EDItEUR::J Society and Social Sciences::JP Politics and government::JPQ Central / national / federal government::JPQB Central / national / federal government policies"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/181588","cover_url":"https://directory.doabooks.org/rest/bitstreams/0828b0b3-04ee-4db9-9aa1-0b559a160c1f/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116617/1/9781350574823.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/181588","handle":"20.500.12854/181588","dspace_uuid":"b92aefad-677a-4174-b441-74466e390d22"},"providers":[{"source":"DOAB","source_id":"20.500.12854/181588","source_url":"https://directory.doabooks.org/handle/20.500.12854/181588","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116617/1/9781350574823.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND","verified_legal":true}]},{"id":"work:2c238edc8513721b3f2ff3ea","title":"Diagnostizieren und Fördern mathematischer Basiskompetenzen","subtitle":"Theorie, Empirie und schulische Praxis - Festschrift für Andrea Peter-Koop","description":"Forschende in der Mathematikdidaktik, Lehrkräfte, Politiker und Politikerinnen, Eltern und Ausbildende – alle sind sich einig, dass die Entwicklung mindestens grundlegender mathematischer Kompetenzen ein zentrales Ziel in der schulischen Bildung darstellt. Weit weniger Einigkeit zeigt sich jedoch bei der Frage, was diese Kompetenzen konkret umfassen und wofür genau solche „Basiskompetenzen“ eigentlich die Basis sein sollen. In den Beiträgen dieses Sammelbands kommen Expertinnen und Experten zu Worte, die aus theoretischer, empirischer und unterrichtspraktischer Perspektive Antworten auf diese Fragen liefern und wichtige Implikationen für die Forschung sowie die Diagnostik und Förderung mathematischer Basiskompetenzen in der Grundschule und an ihren Übergängen aufzeigen.","authors":[],"language":"de","year":2025,"publisher":"Bielefeld University Press","isbn":[],"doi":"10.64136/igbb3218","subjects":["Mathematikdidaktik","Mathematik","Mathematische Basiskompetenzen","Basale mathematische Kompetenzen","Vorläuferfähigkeiten","Numerische Basiskompetenzen","Unterrichtspraxis","Mathematikunterricht","Diagnostik","Förderung","thema EDItEUR::P Mathematics and Science::PB Mathematics::PBC Mathematical foundations","thema EDItEUR::J Society and Social Sciences::JN Education::JNT Teaching skills and techniques","thema EDItEUR::J Society and Social Sciences::JN Education::JNL Schools and pre-schools::JNLB Primary and middle schools"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/181510","cover_url":"https://directory.doabooks.org/rest/bitstreams/b80adfde-7652-402a-9b98-2e9847c48cb3/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116580/1/9783691290110.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/181510","handle":"20.500.12854/181510","dspace_uuid":"3159d2ac-8bd3-4d2f-9cd2-43db58771012"},"providers":[{"source":"DOAB","source_id":"20.500.12854/181510","source_url":"https://directory.doabooks.org/handle/20.500.12854/181510","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116580/1/9783691290110.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND","verified_legal":true}]},{"id":"work:48a27d12b1a7467ace5f1917","title":"Diccionario de Informatica y Telecomunicaciones (Ariel Practicum)","subtitle":"","description":"","authors":["Arturo Moreno Martin"],"language":"es","year":2001,"publisher":"Ariel Publications","isbn":["9788434428867","8434428865"],"doi":"","subjects":[],"source":"Open Library","source_url":"https://openlibrary.org/works/OL9525644W","cover_url":"https://covers.openlibrary.org/b/id/12836059-M.jpg","formats":[],"access":"digital_lending","license":"","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"OL9525644W","openlibrary_work":"OL9525644W","openlibrary_edition":"OL13237634M","internet_archive":"diccionariodeinf0000more"},"providers":[{"source":"Open Library","source_id":"OL9525644W","source_url":"https://openlibrary.org/works/OL9525644W","language":"es","formats":[],"access":"digital_lending","license":"","verified_legal":true}]},{"id":"work:3feeac17b3701fa09681da54","title":"Diccionario múltiple 4 en 1.","subtitle":"","description":"","authors":["Amerrisque (Firm)"],"language":"es","year":2011,"publisher":"Amerrisque","isbn":["9789992471654","9992471654","9789992471678","9992471670"],"doi":"","subjects":[],"source":"Open Library","source_url":"https://openlibrary.org/works/OL23305674W","cover_url":"","formats":[],"access":"metadata_only","license":"","verified_legal":false,"resource_type":"book","identifiers":{"source_id":"OL23305674W","openlibrary_work":"OL23305674W","openlibrary_edition":"OL31152966M"},"providers":[{"source":"Open Library","source_id":"OL23305674W","source_url":"https://openlibrary.org/works/OL23305674W","language":"es","formats":[],"access":"metadata_only","license":"","verified_legal":false}]},{"id":"work:081b9412029e2f754fea7971","title":"Didáctica de la geometría para la escuela primaria","subtitle":"","description":"In the teaching-learning process of Mathematics in Elementary Education, one of the main difficulties is related to the development of geometric skills in schoolchildren. For this reason, the book focuses the study on geometric skills: recognizing geometric objects; tracing and/or constructing; arguing geometric propositions; and solving geometric calculation problems. The book provides the theoretical foundations for the development of geometric skills in elementary education: principles, actions, operations, levels and indicators. It also includes methodological recommendations for the treatment of the fundamental geometric objects that are addressed at this educational level, separated by cycle, due to the way in which the contents are treated in each of the grades. Teachers are also provided with the procedure to carry out some teaching aids for the treatment of geometric contents and the development of skills.","authors":["León-González, Jorge Luis","Barcia-Martínez, Robert"],"language":"en","year":2025,"publisher":"Sophia Editions","isbn":[],"doi":"10.64092/rzis3676","subjects":["Geometric skills","Elementary Education","Teaching-learning process","Methodological recommendations","Teaching aids","thema EDItEUR::P Mathematics and Science::PB Mathematics::PBM Geometry"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/178516.2","cover_url":"https://directory.doabooks.org/rest/bitstreams/2ace7321-d902-4a67-9579-cc5e1f83f456/retrieve","formats":[],"access":"open_access","license":"Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/178516.2","handle":"20.500.12854/178516.2","dspace_uuid":"0779af1c-d1a4-4457-8c5e-cb9cf7a172ec"},"providers":[{"source":"DOAB","source_id":"20.500.12854/178516.2","source_url":"https://directory.doabooks.org/handle/20.500.12854/178516.2","language":"en","formats":[],"access":"open_access","license":"Other open license","verified_legal":true}]},{"id":"work:235b1b181e6d06459cb1a2aa","title":"Die antike Stadt als Gefühlsraum","subtitle":"Rom und Pompeji als Orte der Liebe, Erotik und Sexualität","description":"DECOR is the first series that considers decorative phenomena in a comprehensive way. It moves away from the study of single decorative elements in isolation, focusing instead upon their spatial-architectural and visual correlation and integration. This means that the individual studies analyse not only images, but also ornamental forms of decor. As such, they discuss the visual relationship between decorative elements with differing levels of associated semantics. These elements are assessed precisely with regard to their spatial setting. Thus, the series provides new analyses of image-spaces, or rather ‘decor-spaces’, while bringing the perceptual attitudes of the viewer to the fore, as well. The geographical focus is on Italy, the chronological framework ranges from the 2 nd century B.C. to the late 1 st century A.D. This period saw profound political and social upheaval but also fundamental changes in decorative principles, providing an ideal starting point for analyses of the relationships between shifting forms of action and experience, as well as variations in strategies of decor.","authors":["Haug, Annette"],"language":"de","year":2025,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Erotic poetry","Epigraphy","Graffiti","Emotion","Epigraphik","Gefühle","Liebeselegie","thema EDItEUR::N History and Archaeology::NH History::NHC Ancient history"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116892","cover_url":"https://library.oapen.org/rest/bitstreams/95507148-94d8-48a2-aeb5-a1ecbb1fa755/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/39f74693-ee37-400d-ac05-b345d5449b8b/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116892","handle":"20.500.12657/116892","dspace_uuid":"e486df1f-170f-4cef-840d-c9e1c5fe26e8"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116892","source_url":"https://library.oapen.org/handle/20.500.12657/116892","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/39f74693-ee37-400d-ac05-b345d5449b8b/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true}]},{"id":"work:e5db87f068c78cc3e9a96509","title":"Die emotionalen Landschaften der extremen Rechten","subtitle":"","description":"Die extreme Rechte gewinnt heute auch deshalb an Einfluss, weil demokratische Kräfte ihre blinden Flecken nicht überwinden. Den etablierten Parteien fällt es zunehmend schwer, das tief sitzende gesellschaftliche Unbehagen zu erkennen und auf die Anliegen breiter Bevölkerungsschichten einzugehen. In vielen Ländern Amerikas und Europas entstehen so neue emotionale Landschaften. Alejandro Grimson widerspricht der verbreiteten Annahme, der Aufstieg der extremen Rechten als Massenphänomen sei Ausdruck gesellschaftlicher Irrationalität. Stattdessen zeigt er, dass ihm ein tiefgreifender kultureller Wandel zugrunde liegt, der von technologischen, wirtschaftlichen und arbeitsweltlichen Veränderungen geprägt ist. Anhand von Wut, Ressentiment, Angst und den widersprüchlichen Bedeutungen von Nostalgie analysiert Grimson, wie die extreme Rechte politische Feindbilder konstruiert und Emotionen gezielt für ihre Zwecke instrumentalisiert. Zugleich stellt er die entscheidende Frage: Welche Antworten haben demokratische Kräfte auf die neuen gesellschaftlichen Stimmungen und Empfindlichkeiten? Abschließend widmet sich das Buch dem Aufstieg Javier Mileis in Argentinien und untersucht, wie es ihm gelang, die neu entstandene emotionale Dynamik politisch zu nutzen. Daraus entwickelt Grimson grundlegende Fragen zur Zukunft Argentiniens, seiner Regierung und der extremen Rechten.","authors":["Grimson (0000000171774853), Alejandro"],"language":"de","year":2026,"publisher":"Bielefeld University Press","isbn":[],"doi":"10.64136/szjg3678","subjects":["Extreme Rechte","Politische Kultur","Emotionen und Politik","Argentinien","Gesellschaftlicher Wandel","thema EDItEUR::J Society and Social Sciences::JP Politics and government::JPF Political ideologies and movements::JPFQ Far-right political ideologies and movements"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/181429","cover_url":"https://directory.doabooks.org/rest/bitstreams/c7ba5263-ea93-4c10-9238-c3075dada32b/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116597/1/9783691290554.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by/4.0/ · CC-BY","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/181429","handle":"20.500.12854/181429","dspace_uuid":"f3e42510-2fdf-4a97-9430-85584a95e717"},"providers":[{"source":"DOAB","source_id":"20.500.12854/181429","source_url":"https://directory.doabooks.org/handle/20.500.12854/181429","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116597/1/9783691290554.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by/4.0/ · CC-BY","verified_legal":true}]},{"id":"work:40413ac59267d178ad9ddb49","title":"Die Erfindung der Tragödie","subtitle":"Zur Evolution der Gattung um 1800","description":"The series \"QUELLEN UND FORSCHUNGEN ZUR LITERATUR- UND KULTURGESCHICHTE\" (Sources and Research in the History of Literature and Culture), with a rich tradition stretching back to 1874, is an established feature among the renowned publications for German Literary Studies. Edited by Mark-Georg Dehrmann and Christiane Witthöft, the series presents examples of high-quality scholarship examining literary texts in conjunction with historical cultural phenomena, particularly with the other arts. There is an explicit demand for literary studies with a transdisciplinary approach. German literature from the Middle Ages to the present day forms the main focus of the series. As the historical cultural thrust of the series includes aspects of intercultural experience and national perceptions of the other, Quellen und Forschungen is also open to occasional comparative studies. The publications of the series include monographs, doctoral and professorial theses. Works presented for acceptance in the series are required to display scholarly relevance and excellence in method and presentation.","authors":["Schmidt, Johannes U."],"language":"de","year":2026,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Tragedy","Genre theory","Sattelzeit","Literary history","Gattungstheorie","Literaturgeschichte","Tragödie","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism::DSG Literary studies: plays and playwrights","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism::DSA Literary theory"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116854","cover_url":"https://library.oapen.org/rest/bitstreams/0e5c65ae-2b98-4b56-9f39-a3f1ef7b6800/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/ef1324e7-87a0-40f6-b0be-b4f29ce89ffe/retrieve"},{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116854/1/9783111711751.pdf"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by/4.0/ · CC-BY · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116854","handle":"20.500.12657/116854","dspace_uuid":"7c7c321e-a6c2-4777-aee8-7e6f188c8a26","doab_source_id":"20.500.12854/181451","doab_handle":"20.500.12854/181451","doab_dspace_uuid":"e8246abc-1d40-4790-9a46-f50b19971c46"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116854","source_url":"https://library.oapen.org/handle/20.500.12657/116854","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/ef1324e7-87a0-40f6-b0be-b4f29ce89ffe/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by/4.0/ · CC-BY · Other open license","verified_legal":true},{"source":"DOAB","source_id":"20.500.12854/181451","source_url":"https://directory.doabooks.org/handle/20.500.12854/181451","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116854/1/9783111711751.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by/4.0/ · CC-BY","verified_legal":true}]},{"id":"work:d4d1753913023e2123ab8fe5","title":"Die Ethik des Traums in den Werken Plutarchs von Chaironeia","subtitle":"Wissen und Ereignis","description":"Millennium transcends boundaries – between epochs and regions, and between disciplines. Like the journal Millennium-Jahrbuch , the Millennium-Studien pursues an international, interdisciplinary approach that cuts across historical eras. The editorial and the advisory board represent a broad spectrum of disciplines: contributions from the fields of art and literature are just as well represented as historical, theological and philosophical contributions, and studies on Latin and Greek cultures as well as North African and Near Eastern cultures. In addition to offering a forum for monographs and edited collections on diverse topics, Millennium-Studien publishes commentaries and editions. Publication languages are primarily German and English; French, Italian and Spanish studies may be included. Series editors Wolfram Brandes , Frankfurt, Germany (Byzantine Studies and Early Middle Ages): brandeswolfram@gmail.com Laura Carrara , Pisa, Italy (Greek language and literature): laura.carrara@unipi.it Dennis Pausch , Marburg, Germany (Latin language and literature): dennis.pausch@uni-marburg.de Rene Pfeilschifter , Würzburg, Germany (Ancient History): Rene.Pfeilschifter@uni-wuerzburg.de Karla Pollmann , Tübingen, Germany (Early Christianity and Patristics): karla.pollmann@uni-tuebingen.de If you want to submit a manuscript for the Millennium Studies please send it to the series editor from the most relevant discipline. All manuscript submissions will be reviewed by the series editor and one outside specialist (single-blind peer review). Editorial Board: Phil Booth , University of Oxford, UK Patricia Ciner , National University of SanJuan, Argentinia Babett Edelmann-Singer , Freie Universität Berlin, Germany Philip Forness , Katholieke Universiteit Leuven, Belgium Lea Niccolai , Trinity College, University of Cambridge, UK Claudia Rapp , Universität Wien, Austria Verena Schulz , Katholische Universität Eichstätt, Germany Chiara Tommasi , Università di Pisa, Italy Lieve Van Hoof , Ghent University, Belgium","authors":["Schliephake, Christopher"],"language":"de","year":2026,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Plutarchus","Traum","Divination","Römisches Reich","Plutarch","Dream","Roman Empire","thema EDItEUR::D Biography, Literature and Literary studies::DB Ancient, classical and medieval texts::DBS Ancient Sagas and epics::DBSG Ancient Greek and Roman literature","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism::DSB Literary studies: general::DSBB Literary studies: ancient, classical and medieval"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116905","cover_url":"https://library.oapen.org/rest/bitstreams/d9212011-dc59-4340-b142-a3152695f8a4/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/5da4320b-9b78-4e62-92a1-7efb79ba0f0f/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116905","handle":"20.500.12657/116905","dspace_uuid":"e4419a5b-02f3-4109-a463-614673f160e2"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116905","source_url":"https://library.oapen.org/handle/20.500.12657/116905","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/5da4320b-9b78-4e62-92a1-7efb79ba0f0f/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true}]},{"id":"work:7e75fda748d62e751c5f7722","title":"Die Kirche Jesu Christi / The Church of Jesus Christ","subtitle":"","description":"»The Church of Jesus Christ« is regarded as the most widely received doctrinal text of the Communion of Protestant Churches in Europe (CPCE). It was adopted by the General Assembly in 1994. It was the first time that the churches of the Reformation developed the basic insights into the church and its mission contained in the Leuenberg Agreement and fundamentally defined their understanding of »unity in reconciled diversity«. On the basis of God’s action in Christ as the foundation of the church and its mission as witness to salvation, it reflects on the concrete shape of the church and its mission in the world. The text has given important stimuli for the realisation and deepening of church communion in the CPCE and for ecumenical dialogue. It has found a kind of continuation in the outcome of the 2018 doctrinal dialogue »Church Communion«.","authors":[],"language":"de","year":2025,"publisher":"Evangelische Verlagsanstalt","isbn":[],"doi":"10.36199/978-3-374-07944-5","subjects":["Theology","Ecumenical Theology","Community of Protestant Churches in Europe","The concrete form of the Church","Ministry","The Christian’s mission in the world","Ecumenism","thema EDItEUR::Q Philosophy and Religion::QR Religion and beliefs::QRM Christianity::QRMB Christian Churches, denominations, groups","thema EDItEUR::Q Philosophy and Religion::QR Religion and beliefs::QRM Christianity"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/117081","cover_url":"https://library.oapen.org/rest/bitstreams/6295fbe7-3dcf-48ee-9fe5-2cdbbcbbbbb2/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/28b1072b-5585-439b-bf8b-b2129f6690b2/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/117081","handle":"20.500.12657/117081","dspace_uuid":"36fb82f3-e8c4-4561-a054-12330d545deb"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/117081","source_url":"https://library.oapen.org/handle/20.500.12657/117081","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/28b1072b-5585-439b-bf8b-b2129f6690b2/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true}]},{"id":"work:e9eb90183dfb1817c07d8c76","title":"Die klandestine Zeitschrift Diáspora(s)","subtitle":"Netzwerke, Textnetze und Protestkultur der kubanischen Sonderperiode","description":"As its title indicates, the book series \"Latin American Literatures in the World\" presents an innovative understanding of literatures written in Latin America and the Caribbean. Informed by current perspectives on world literary studies and cultural theory, the series focuses on works that deal with the multiple global connections of Latin American literatures. This comprises determined aesthetics and forms of writing, as well as book-market-related phenomena of the worldwide reception and circulation of these literatures. Understanding Latin American literature’s transnational orientation as its essential feature, the series seeks to provide new perspectives on the global entanglements of Latin America. A special emphasis is placed on works that consider relations and exchanges with Asia, Africa and other world regions beyond the traditional transatlantic focus. Como su título lo indica, la serie \"Literaturas latinoamericanas en el mundo\" representa un entendimiento innovador de las literaturas concebidas como latinoamericanas y caribeñas. A partir de postulados actuales de los estudios de la literatura mundial y la teoría cultural, la serie se centra en trabajos que investigan las múltiples conexiones globales de las literaturas latinoamericanas. Este enfoque comprende tanto la transferencia de determinadas estéticas y escrituras al igual que fenómenos de mercado, de recepción y puesta en circulación internacionales. En base a la orientación transnacional de las literaturas latinoamericanas como una de sus características fundamentales, la serie busca promover abordajes críticos e innovadores sobre esos entrelazamientos globales de América Latina. Un interés particular consiste en los trabajos que investigan los intercambios con Asia, África y otras regiones del mundo más allá del tradicional enfoque transatlántico. Series editor / directora : Gesine Müller, Universität zu Köln Advisory board / consejo científico : Ana Gallego, Universidad de Granada Gustavo Guerrero, CY Cergy Paris University Héctor Hoyos, Stanford University Benjamin Loy, Ludwig-Maximilians-Universität München Ignacio Sánchez Prado, Washington University in St. Louis Mariano Siskind, Harvard University Patricia Trujillo, Universidad Nacional de Colombia","authors":["Rempel, Natascha"],"language":"de","year":2025,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Revista Diáspora(s)","Cuban Special Period","Underground literature","Intellectual networks","Sonderperiode in Kuba","Untergrundliteratur","Intellektuellennetzwerke","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism::DSB Literary studies: general::DSBH Literary studies: c 1900 to c 2000","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism","thema EDItEUR::G Reference, Information and Interdisciplinary subjects::GL Library and information sciences / Museology::GLM Library and information services"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/181534","cover_url":"https://directory.doabooks.org/rest/bitstreams/bce3ee62-ecde-4947-88fb-46bdc7bcd922/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116776/1/9783111637051.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by/4.0/ · CC-BY","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/181534","handle":"20.500.12854/181534","dspace_uuid":"d223eac1-ea8f-4432-aa23-ec0903400348"},"providers":[{"source":"DOAB","source_id":"20.500.12854/181534","source_url":"https://directory.doabooks.org/handle/20.500.12854/181534","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116776/1/9783111637051.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by/4.0/ · CC-BY","verified_legal":true}]},{"id":"work:a18fe2546cf7e8e91affbeec","title":"Die Selbstbildnissammlung der Medici 1650-1723","subtitle":"Frühneuzeitliche Strategien zur Auslotung und Formung von Evidenz","description":"The 'Galleria degli Autoritratti' in the Uffizi, Florence, is the largest collection of artists' self-portraits in the world. It was founded in 1650 by Leopoldo de' Medici, and his heir Cosimo III expanded and reorganized it. Assisted by a network of agents and guided by empirical research criteria, the two patrons acquired only genuine self-portraits. The outcome was a unique, special collection closely linked to the epistemological approaches of the 17th century. Anna Maria Jonietz is the first to analyze the art-theoretical and academic-historical aspects of the 'Galleria.' She sheds light on the strategies of showing and convincing and demonstrates how the historical exhibition concept enabled a visual study of art and its history.","authors":["Jonietz, Anna Maria"],"language":"de","year":2025,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Art","16th century","17th century","Early Modern Period","Italy","Florence","Medici","Self portrait","Portrait","Uffizi Galleries","Collection","Kunst","Malerei","Frühe Neuzeit","17. Jahrhundert","18. Jahrhundert","Italien","Florenz","Selbstbildnis","Porträt","Künstlerselbstbildnis","Uffizien","Sammlung","thema EDItEUR::A The Arts::AG The Arts: treatments and subjects::AGA History of art","thema EDItEUR::A The Arts::AF The Arts: art forms::AFC Paintings and painting","thema EDItEUR::A The Arts::AG The Arts: treatments and subjects::AGC Exhibition catalogues and specific collections"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116929","cover_url":"https://library.oapen.org/rest/bitstreams/614b7237-4d90-4fd5-a612-dc294ba4d864/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/5e5c5453-457d-49e3-ab64-c8e333134c07/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by/4.0/ · CC-BY · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116929","handle":"20.500.12657/116929","dspace_uuid":"ead69d3d-0266-4e16-b6f4-382037e87945"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116929","source_url":"https://library.oapen.org/handle/20.500.12657/116929","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/5e5c5453-457d-49e3-ab64-c8e333134c07/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by/4.0/ · CC-BY · Other open license","verified_legal":true}]},{"id":"work:54763dc37a9b507166135c89","title":"Die Verfügbarkeit des Unverfügbaren","subtitle":"Kommunikation mit Gott im lateinischen Christentum des europäischen Mittelalters","description":"This series addresses the demands for a comparative study of the European Middle Ages often voiced in medieval studies, but rarely realised in a sustainable manner. Since 1999, monographs and anthologies have been published in this series that deal with social or cultural-historical, legal, or constitutional-historical issues from a European perspective. In recent years, increasing attention has been paid to trans-cultural global historical research into Europe as part of the medieval world.","authors":["Weitzel, Tim"],"language":"de","year":2025,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["History of religion","Middle Ages","Prayer","History of communication","Gebet","Kommunikationsgeschichte","Mittelalter","Religionsgeschichte","thema EDItEUR::N History and Archaeology::NH History::NHD European history::NHDJ European history: medieval period, middle ages","thema EDItEUR::N History and Archaeology::NH History::NHD European history","thema EDItEUR::Q Philosophy and Religion::QR Religion and beliefs::QRM Christianity"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/181545","cover_url":"https://directory.doabooks.org/rest/bitstreams/688f0c44-52d5-454b-ae97-fcb68e23088e/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116693/1/9783112206423.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by/4.0/ · CC-BY","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/181545","handle":"20.500.12854/181545","dspace_uuid":"74688904-af4e-4548-ab22-c3fa6ade84b6"},"providers":[{"source":"DOAB","source_id":"20.500.12854/181545","source_url":"https://directory.doabooks.org/handle/20.500.12854/181545","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116693/1/9783112206423.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by/4.0/ · CC-BY","verified_legal":true}]},{"id":"work:a5c2a00c534abada651c0be0","title":"Die Wächterstimme im Hohenfurter Liederbuch","subtitle":"","description":"\"Cultures of Vigilance\" aims to research the historical and cultural foundations of vigilance. Within this context, \"vigilance\" refers to a linking of individual attentiveness to goals set by others. This linking occurs on an everyday basis, be it in the realm of public security, religion, law, or the healthcare sector; wherever and whenever we are asked to pay attention to something specific and, if necessary, also to react to, or report anything we have noticed in a specific way. The goal is to analyse the history, cultural variations and current forms of this phenomenon.","authors":["Casadevall Ferrer, Agnes"],"language":"de","year":2026,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Guardian figure","Spiritual song of the day","Vigilance","Songbook poetry","Wächterfigur","Geistliches Tagelied","Wachsamkeit","Liederbuchlyrik","thema EDItEUR::N History and Archaeology::NH History::NHD European history::NHDJ European history: medieval period, middle ages","thema EDItEUR::A The Arts::AV Music::AVQ Musical scores, lyrics and libretti::AVQS Songbooks","thema EDItEUR::N History and Archaeology::NH History::NHD European history"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116928","cover_url":"https://library.oapen.org/rest/bitstreams/dccef809-8b12-4756-8c67-49d38bc80449/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/7fb5751a-0ef4-422e-82cc-8fa3f9c29bd8/retrieve"},{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116928/1/9783112215708.pdf"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by/4.0/ · CC-BY · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116928","handle":"20.500.12657/116928","dspace_uuid":"8522932e-cbbc-48ad-9b56-0fb73ce6d9a7","doab_source_id":"20.500.12854/181465","doab_handle":"20.500.12854/181465","doab_dspace_uuid":"69459450-ee04-43c3-ba2e-88cc1c99155f"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116928","source_url":"https://library.oapen.org/handle/20.500.12657/116928","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/7fb5751a-0ef4-422e-82cc-8fa3f9c29bd8/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by/4.0/ · CC-BY · Other open license","verified_legal":true},{"source":"DOAB","source_id":"20.500.12854/181465","source_url":"https://directory.doabooks.org/handle/20.500.12854/181465","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116928/1/9783112215708.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by/4.0/ · CC-BY","verified_legal":true}]},{"id":"work:1f811bc35df525183887f18a","title":"Die Zukunft des kulturellen Erbes","subtitle":"Strategien und Konzepte aus Politik und Praxis","description":"How can cultural heritage stay alive in a changing society dealing with climate change and armed conflict? And what political frameworks are needed to shape a sustainable cultural landscape? In this volume, experts from the fields of culture, politics and science explore the current challenges and future prospects in handling our cultural heritage. They present strategies that enable appropriate protection, contemporary communication, and sustainable development. The contributions provide valuable insights for anyone involved in the strategic development of cultural heritage and wanting to actively shape the future of our cultural identity. First volume of Patrimonia published by Deutscher Kunstverlag Innovative strategies for dealing with our cultural heritage","authors":[],"language":"de","year":2025,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Cultural heritage","Art","Preservation of heritage","Cultural policy","Patrimonia","Kulturelles Erbe","Kulturerbe","Kulturpolitik","Kunst","thema EDItEUR::A The Arts::AG The Arts: treatments and subjects::AGC Exhibition catalogues and specific collections","thema EDItEUR::A The Arts::AG The Arts: treatments and subjects::AGA History of art"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116913","cover_url":"https://library.oapen.org/rest/bitstreams/0a2f8830-214f-4467-ab85-c4d7d4841fe2/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/182de595-ded4-41bd-a321-69a70539fc3a/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116913","handle":"20.500.12657/116913","dspace_uuid":"1ddaf980-ab46-42a8-9a7f-647305322000"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116913","source_url":"https://library.oapen.org/handle/20.500.12657/116913","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/182de595-ded4-41bd-a321-69a70539fc3a/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true}]},{"id":"work:e7c19c7b2785c94e9171f328","title":"Diggers","subtitle":"","description":"","authors":["Terry Pratchett"],"language":"de","year":1990,"publisher":"Turtleback Books Distributed by Demco Media","isbn":["038526979X","5699108092","1407042637","9780385301527","0552551015","0385301529","0062193813","0606325204","2081642905","9781407042626","9780385269803","9781407042633","9780745116372","9788441305281","9781407042619","8477226636","1407042610","9781846576621","9780385269797","9783453062641","9782081646421","9781407042640","3453062647","1846576628","9780060094942","9788477226635","9785699108091","2081646420","006009494X","1407042629","9780606325202","9782081642904","9780062193810","0552525863","1407042645","9780552551014","9782277241799","9780552525862","9780552573344","8441305285","074511637X","2277241792","0552573345","0385269803"],"doi":"","subjects":[],"source":"Open Library","source_url":"https://openlibrary.org/works/OL453695W","cover_url":"https://covers.openlibrary.org/b/id/14646163-M.jpg","formats":[],"access":"digital_lending","license":"","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"OL453695W","openlibrary_work":"OL453695W","openlibrary_edition":"OL10943921M","internet_archive":"diggers0000prat_p7e8"},"providers":[{"source":"Open Library","source_id":"OL453695W","source_url":"https://openlibrary.org/works/OL453695W","language":"de","formats":[],"access":"digital_lending","license":"","verified_legal":true}]},{"id":"work:a6837face6330a91c82f26a5","title":"Digital Archives of Science","subtitle":"Revisiting the Vestiges of Knowledge-Making","description":"The archive of science preserves the sediments of scientific practices: drafts, protocols of rejected hypotheses and failed experiments, obsolete instruments and other vestiges of knowledge-making. As science becomes increasingly digital, so does its archive – transforming not only how the scientific past is preserved, but how it is interpreted and engaged with. Digital collections clearly differ from the traditional lieux de mémoire . Rather than tangible and authentic objects, they store data – processable, mutable, and dependent on computational infrastructures. How do these infrastructures shape our encounters with the scientific past? What happens to the vestiges of science when they turn into data? Positioned at the intersection of Science Studies, Media Studies, and Digital Humanities, this book critically examines digital archives of science as infrastructures that mediate memory and knowledge. Drawing on a large corpus of scientifi c collections across disciplines and combining quantitative and qualitative approaches, it explores the boundaries and possibilities introduced by these digital repositories. Ultimately, it asks what it means to do history in and through digital archives.","authors":["Volynskaya, Alina"],"language":"en","year":2026,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Digital archive","Scientific collection","Digital infrastructure","Digitales Archiv","Wissenschaftssammlung","Digitale Infrastruktur","thema EDItEUR::J Society and Social Sciences::JB Society and culture: general::JBC Cultural and media studies::JBCT Media studies::JBCT1 Media studies: internet, digital media and society","thema EDItEUR::G Reference, Information and Interdisciplinary subjects::GL Library and information sciences / Museology::GLC Library, archive and information management","thema EDItEUR::N History and Archaeology::NH History::NHB General and world history","thema EDItEUR::N History and Archaeology::NH History"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116869","cover_url":"https://library.oapen.org/rest/bitstreams/8e0789d9-d628-422c-8a5b-d50222fddade/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/324b6cee-a4ef-4920-8d45-8e481899f2a4/retrieve"},{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116869/1/9783111729664.pdf"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc/4.0/ · CC-BY-NC · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116869","handle":"20.500.12657/116869","dspace_uuid":"4f809a0b-b439-470a-9581-173a9b3c7299","doab_source_id":"20.500.12854/181385","doab_handle":"20.500.12854/181385","doab_dspace_uuid":"102b3805-27ae-4777-834b-587d19772599"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116869","source_url":"https://library.oapen.org/handle/20.500.12657/116869","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/324b6cee-a4ef-4920-8d45-8e481899f2a4/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc/4.0/ · CC-BY-NC · Other open license","verified_legal":true},{"source":"DOAB","source_id":"20.500.12854/181385","source_url":"https://directory.doabooks.org/handle/20.500.12854/181385","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116869/1/9783111729664.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by-nc/4.0/ · CC-BY-NC","verified_legal":true}]},{"id":"work:3d8bb1649909e5169bfc429f","title":"Digital Exhaustion","subtitle":"Burnout, Fatigue, and Overload in the Age of Constant Connectivity","description":"Daily life in digital culture is exhausting. This timely and urgent edited collection takes the theme of ‘digital exhaustion’ as a starting point for critical inquiry into the ever-expanding presence of digital technologies in our personal and professional lives.","authors":["Taylor, A.R.E.","Kopitz, Linda","Soncul, Yiğit","Kviat, Alexandra"],"language":"en","year":2026,"publisher":"Intellect","isbn":[],"doi":"","subjects":["Digital capitalism","Platform","Platforms","Disconnection","Digital detox","Labor","Labour","Workplace","Right to Disconnect","Anthropology","Social anthropology","Cultural anthropology","Digital anthropology","Media studies","Communication studies","Media and communications","Media and communication studies","Cultural studies","Humanities","Digital humanities","thema EDItEUR::J Society and Social Sciences::JB Society and culture: general::JBC Cultural and media studies","thema EDItEUR::J Society and Social Sciences::JB Society and culture: general","thema EDItEUR::U Computing and Information Technology::UD Digital Lifestyle and online world: consumer and user guides"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116954","cover_url":"https://library.oapen.org/rest/bitstreams/b50b706b-af2b-45bc-9617-5fea92914746/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/2bffb6a2-6ad6-4a83-bfea-773bc978bc80/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by/4.0/ · CC-BY · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116954","handle":"20.500.12657/116954","dspace_uuid":"f409eb85-dd5e-4a6d-9258-ce33f04fd1b2"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116954","source_url":"https://library.oapen.org/handle/20.500.12657/116954","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/2bffb6a2-6ad6-4a83-bfea-773bc978bc80/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by/4.0/ · CC-BY · Other open license","verified_legal":true}]},{"id":"work:31a52cf04584b30ab0ce8b51","title":"Dilemmas and Uncertainties","subtitle":"The Sciences at the Early Modern University","description":"The authors of this volume bring new insights to the intellectual history of knowledge and belief in sciences, and they do so by focusing on the presence of debates and multiple truths in university context. It has been observed that “in the past two decades, scholars have come to value uncertainty as an important key to seventeenth-century Catholicism”, and this statement could be easily extended to Protestant intellectual traditions, as well. After that earlier research had focused on skepticism and doubt in the early modern era for a long time, recent scholarship has come to understand the importance of multiple truths, and the practices of choosing between more or less probable options. Probabilism, choosing the more probable option seems to have been a wide-reaching and pervasive intellectual behavior that has been often overlooked. Multiple, diverse truths did not necessarily imply a skeptic attitude to scientific or theological questions: instead, they taught the reader, the student, to argue for or against, and to understand the importance of choosing between the options. Moreover, they maintained a space for another notion of central importance in early modern intellectual traditions: belief . From Paris to Prague, from Tartu to Padua, these papers revolve around problems that raised uncertainties in the early modern mind. In some cases, these were born out of new experiences and insights that shaped existing sets of knowledge, while in other cases, they were based on theoretical concerns. But they all clearly show that uncertainty was a central – and productive – element of early modern scholarship, which was transmitted to the students already during their years of study.","authors":[],"language":"en","year":2026,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Education","Debate","Early modern period","Confessionalism","Bildung","Debatte","Frühe Neuzeit","Konfessionalismus","thema EDItEUR::Q Philosophy and Religion::QD Philosophy::QDH Philosophical traditions and schools of thought::QDHH Humanist philosophy","thema EDItEUR::Q Philosophy and Religion::QD Philosophy::QDT Topics in philosophy","thema EDItEUR::Q Philosophy and Religion::QD Philosophy::QDH Philosophical traditions and schools of thought::QDHR Western philosophy from c 1800","thema EDItEUR::Q Philosophy and Religion::QD Philosophy"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/181504","cover_url":"https://directory.doabooks.org/rest/bitstreams/d98df526-06d0-41ae-8b96-bd2bb74ddc91/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116774/1/9783111712697.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by/4.0/ · CC-BY","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/181504","handle":"20.500.12854/181504","dspace_uuid":"5aa9f21b-7002-4dcd-9c97-cc7bf9c491b9"},"providers":[{"source":"DOAB","source_id":"20.500.12854/181504","source_url":"https://directory.doabooks.org/handle/20.500.12854/181504","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116774/1/9783111712697.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by/4.0/ · CC-BY","verified_legal":true}]},{"id":"work:8dac693c34cf07847952e59c","title":"Dilemmas of China's Growth in the Twenty-First Century","subtitle":"","description":"Since economic reforms began in 1978, China has been a focal point for observing the effects of market liberalisation. China has not only truly become one of the 'emerging giants' in the world economy but also provided a successful example for transition from a centrally-planned to a market economy. Thus, there is a keen interest about what lies ahead for such a significant economic player. Dilemmas of China’s Growth in the Twenty-First Century is a comprehensive treatment of China’s economic achievements to date and prospects for the twenty-first century. Covering topics as diverse as economic stability and growth sustainability, WTO membership and its implications, income disparity, agricultural policy, trade and investment prospects, Dilemmas of China’s Growth in the Twenty-First Century is a powerful work and essential guide to the latest trends and prospects for the Chinese economy.","authors":["Song, Ligang"],"language":"en","year":2012,"publisher":"ANU Press","isbn":[],"doi":"10.22459/dcg.12.2012","subjects":["Economic growth","Financial markets","Market economy","Economic policy","Economics","Political stability","Economic stability","China","thema EDItEUR::K Economics, Finance, Business and Management::KC Economics","thema EDItEUR::J Society and Social Sciences::JB Society and culture: general","thema EDItEUR::J Society and Social Sciences::JP Politics and government","thema EDItEUR::J Society and Social Sciences::JH Sociology and anthropology::JHM Anthropology"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116553","cover_url":"https://library.oapen.org/rest/bitstreams/ac02e168-7409-4ace-a72f-43f7f18e10ef/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/958b393b-bc4e-4ffe-ba2e-3e36b3fdc0a8/retrieve"},{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116553/1/9781922144591.pdf"}],"access":"open_access","license":"Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116553","handle":"20.500.12657/116553","dspace_uuid":"7a2c127a-3850-4966-89b7-126727731a6e","doab_source_id":"20.500.12854/181448","doab_handle":"20.500.12854/181448","doab_dspace_uuid":"c8852a09-0931-452a-8a65-df6892af7ac4"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116553","source_url":"https://library.oapen.org/handle/20.500.12657/116553","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/958b393b-bc4e-4ffe-ba2e-3e36b3fdc0a8/retrieve"}],"access":"open_access","license":"Other open license","verified_legal":true},{"source":"DOAB","source_id":"20.500.12854/181448","source_url":"https://directory.doabooks.org/handle/20.500.12854/181448","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116553/1/9781922144591.pdf"}],"access":"open_access","license":"open access · Other open license","verified_legal":true}]},{"id":"work:a7034f28d76d24273c1d4913","title":"Disaster Recovery through Women’s Eyes","subtitle":"Reimagining Resilience","description":"This book (re)centers women’s situated knowledges as a powerful starting point for analyzing disaster recovery and rethinking the contested concept of resilience. Through an ethnographic account of reconstruction following Typhoon Yolanda in the Philippines, it demonstrates how women’s everyday negotiations with loss and personal aspirations form new imaginaries of recovery grounded in a feminist ethics of care. Disaster Recovery through Women’s Eyes offers readers a conceptual understanding of resilience as “lived” and entangled in processes of becoming – directly challenging conventional, often neoliberal, frameworks of recovery. It delivers these insights through evocative writing coupled with women’s photomediated narratives. By focusing on women’s everyday practices, embodied labors, and emotional relations, the book draws attention to how recovery is a work of creation, self-formation, and hope amidst loss. This approach provides readers with a lens to view resilience as an open project constantly in the making, offering a critical alternative to technocentric models and a grounded basis for more ethical, “care-full” reconstruction practices. This book is intended for scholars and students in disaster studies, gender studies, anthropology, development, and environmental studies. Its photo-based methodology will also interest those working with creative social science methods. Crucially, this work provides critical insights for practitioners and policymakers rethinking how communities are governed during and after disasters and how to incorporate perspectives of care in recovery programs.","authors":["Alburo-Cañete, Kaira Zoe"],"language":"en","year":2026,"publisher":"Taylor & Francis","isbn":[],"doi":"10.4324/9781003694069","subjects":["Gender studies","Women studies","Natural disasters","Disaster recovery","Cultural studies","Feminist studies","thema EDItEUR::J Society and Social Sciences::JH Sociology and anthropology::JHM Anthropology::JHMC Social and cultural anthropology","thema EDItEUR::J Society and Social Sciences::JB Society and culture: general::JBS Social groups, communities and identities::JBSF Gender studies, gender groups::JBSF1 Gender studies: women and girls","thema EDItEUR::R Earth Sciences, Geography, Environment, Planning::RN The environment::RNR Natural disasters","thema EDItEUR::J Society and Social Sciences::JB Society and culture: general::JBS Social groups, communities and identities::JBSF Gender studies, gender groups","thema EDItEUR::J Society and Social Sciences::JB Society and culture: general::JBC Cultural and media studies::JBCC Cultural studies","thema EDItEUR::J Society and Social Sciences::JB Society and culture: general::JBS Social groups, communities and identities::JBSL Ethnic studies::JBSL1 Ethnic groups and multicultural studies"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116996","cover_url":"https://library.oapen.org/rest/bitstreams/f40a0c0d-4f0e-47e8-9262-ead5473757d4/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/25c52051-2848-42aa-ac4a-8a6494fe2223/retrieve"},{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116996/1/9781040839348.pdf"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116996","handle":"20.500.12657/116996","dspace_uuid":"8bad280c-dc5c-41f3-98ef-2ea5584c912c","doab_source_id":"20.500.12854/181479","doab_handle":"20.500.12854/181479","doab_dspace_uuid":"aafa7f80-8062-4677-a863-0508b7b3d5e2"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116996","source_url":"https://library.oapen.org/handle/20.500.12657/116996","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/25c52051-2848-42aa-ac4a-8a6494fe2223/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true},{"source":"DOAB","source_id":"20.500.12854/181479","source_url":"https://directory.doabooks.org/handle/20.500.12854/181479","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116996/1/9781040839348.pdf"}],"access":"creative_commons","license":"open access