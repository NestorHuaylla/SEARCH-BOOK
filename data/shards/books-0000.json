tifiers":{"source_id":"6800d401ac1713c46540","list_url":"https://raw.githubusercontent.com/EbookFoundation/free-programming-books/main/books/free-programming-books-es.md"},"providers":[{"source":"Free Programming Books","source_id":"6800d401ac1713c46540","source_url":"https://es.wikibooks.org/wiki/El_Manual_de_BASH_Scripting_B%C3%A1sico_para_Principiantes","language":"es","formats":[],"access":"author_free","license":"","verified_legal":true}]},{"id":"work:be8efe1ac5d4f3d2324728f1","title":"El Manual del Administrador de Debian","subtitle":"","description":"","authors":["Raphaël Hertzog","Roland Mas"],"language":"es","year":null,"publisher":"","isbn":[],"doi":"","subjects":["Programación","Linux"],"source":"Free Programming Books","source_url":"https://debian-handbook.info/browse/es-ES/stable/","cover_url":"","formats":[{"type":"html","url":"https://debian-handbook.info/browse/es-ES/stable/"}],"access":"author_free","license":"","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"9a9d82ef314a68d348c5","list_url":"https://raw.githubusercontent.com/EbookFoundation/free-programming-books/main/books/free-programming-books-es.md"},"providers":[{"source":"Free Programming Books","source_id":"9a9d82ef314a68d348c5","source_url":"https://debian-handbook.info/browse/es-ES/stable/","language":"es","formats":[{"type":"html","url":"https://debian-handbook.info/browse/es-ES/stable/"}],"access":"author_free","license":"","verified_legal":true}]},{"id":"work:cedebfa851f9e9c3694143b8","title":"El modelo pedagógico de resignificación lúdica, un recurso de estimulación intelectual en la edad preescolar","subtitle":"","description":"The education of personality constitutes a complex social phenomenon that guarantees the appropriation by human beings of culture; Hence, the objective of this work was to analyze the correspondence of social objectives and the pedagogical process carried out in some sectors of the province of El Oro, Ecuador. It was necessary to review the specialized literature, as well as collect field information by visiting various educational centers, in order to contract the application in practice of the theories designed for this purpose; whose results highlight a limited knowledge on the part of educators about the most appropriate ways and methods for the comprehensive education of preschool children, presence of taboos and prejudices of preschool educators regarding the stimulation of child development, neglect of insufficient development of language and the communicative dimension of students in general, limited integrative and systemic conception of the educational teaching process that allows achieving the intellectual development of the student. Therefore, it is concluded that it is urgent to appreciate the spheres: sensory-perceptual, affective, cognitive, socio-affective and corporal expression, which allows conceiving a scientific stimulation program, culturally relevant, and in correspondence with the social development objectives of the Republic of Ecuador. The work warns about the logical-intellectual and creative-intellectual subsystems, while the process seeks the education of a child who, from his formation, needs to actively update his intellectual potential in favor of his social, critical and productive insertion.","authors":["Espinoza Freire, Eudaldo Enrique"],"language":"es","year":2024,"publisher":"Sophia Editions","isbn":[],"doi":"10.64092/bijs9053","subjects":["Educación de la personalidad","Estimulación infantil","Desarrollo integral","Proceso pedagógico","Educación preescolar","thema EDItEUR::J Society and Social Sciences::JN Education"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/178545.2","cover_url":"https://directory.doabooks.org/rest/bitstreams/4eb65947-706b-4155-a4d5-8f3a3e364f61/retrieve","formats":[],"access":"open_access","license":"Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/178545.2","handle":"20.500.12854/178545.2","dspace_uuid":"2056bfa9-e732-462a-9ded-a2b87b93877c"},"providers":[{"source":"DOAB","source_id":"20.500.12854/178545.2","source_url":"https://directory.doabooks.org/handle/20.500.12854/178545.2","language":"es","formats":[],"access":"open_access","license":"Other open license","verified_legal":true}]},{"id":"work:7ec3c57e0504e58fbbbd74a6","title":"El neoconstitucionalismo en la protección de los nuevos derechos","subtitle":"","description":"Neoconstitutionalism in Latin America redefines the State to strengthen the protection of human rights, inclusion and pluralism. This model promotes plurinationality, interculturality and social justice, recognizing cultural diversity and the active participation of indigenous peoples and marginalized sectors. In Ecuador, the Montecristi Constitution integrates these principles, promoting material equality, decentralization and respect for indigenous legal systems. This approach includes essential collective, environmental and social rights such as health, education and housing, fundamental for a dignified life. Furthermore, it advocates the separation between politics and religion, respecting freedom of belief and avoiding the political use of faith. Legal pluralism and multiculturalism seek a harmonious coexistence between diverse worldviews, promoting intercultural dialogue and respect for difference. Ecuador leads with its recognition of nature as a subject of law, highlighting the relationship between sustainability and development. The work presented examines the advances, limitations and challenges of Ecuadorian neoconstitutionalism, highlighting its research base from university projects that address topics such as the protection of environmental rights, gender equality and judicial effectiveness, consolidating an inclusive and sustainable justice model.","authors":["Medina-Peña, Rolando","Torres-Espinoza, Juan José"],"language":"es","year":2024,"publisher":"Sophia Editions","isbn":[],"doi":"10.64092/mxyz9684","subjects":["Neoconstitucionalismo","Plurinacionalidad","Derechos colectivos","Interculturalidad","Justicia social","thema EDItEUR::J Society and Social Sciences::JP Politics and government::JPV Political control and freedoms::JPVH Human rights, civil rights"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/178549.2","cover_url":"https://directory.doabooks.org/rest/bitstreams/b9fa0893-32ac-4007-9d1f-b13fedd36723/retrieve","formats":[{"type":"pdf","url":"https://sophiaeditions.com/wp-content/uploads/2025/06/Libro_Derecho_UMET.pdf"}],"access":"open_access","license":"All rights reserved","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/178549.2","handle":"20.500.12854/178549.2","dspace_uuid":"268f0ae0-03d9-477b-87bf-ada9a94d9556"},"providers":[{"source":"DOAB","source_id":"20.500.12854/178549.2","source_url":"https://directory.doabooks.org/handle/20.500.12854/178549.2","language":"es","formats":[{"type":"pdf","url":"https://sophiaeditions.com/wp-content/uploads/2025/06/Libro_Derecho_UMET.pdf"}],"access":"open_access","license":"All rights reserved","verified_legal":true}]},{"id":"work:d466e9ada740c70787c0b062","title":"El nuevo designio constitucional: la transformación jurídica tras la despenalización del aborto en Ecuador","subtitle":"","description":"This book provides a comprehensive analysis of the decriminalization of abortion in Ecuador and its relationship with the transformation of contemporary constitutional thought. The work examines the phenomenon from multiple perspectives, showing how the discussion on abortion extends beyond the criminal sphere to encompass medical, ethical, and social dimensions that directly influence public policy formulation and the interpretation of fundamental rights. The study reveals that the understanding of abortion in the country has been shaped by tensions between traditional views and more rights-guaranteeing approaches seeking to expand recognition of reproductive autonomy. The text addresses major debates on sexual and reproductive rights, highlighting their importance in building a state that respects equality and human dignity. It analyzes the challenges women face in accessing safe and timely health services, as well as the implications of concepts such as conscientious objection when applied restrictively. The book situates these reflections within the international legal framework, indicating how global standards have influenced national discussions regarding the protection of the conceived and the limits of punitive power. Additionally, the book presents a review of the normative evolution and constitutional debates that have shaped Ecuadorian reproductive policy, highlighting social and legal factors that have driven reconsideration of abortion criminalization. The work concludes with a critical and forward-looking perspective, inviting readers to rethink the foundations of the legal system to advance a framework more consistent with human rights and the country’s contemporary realities.","authors":["Echeverría-Carlier, Michael Anthony"],"language":"es","year":2025,"publisher":"Sophia Editions","isbn":[],"doi":"10.64092/qzdx2572","subjects":["Descriminalización del aborto","Derechos reproductivos","Autonomía reproductiva","Derecho constitucional","Políticas públicas","thema EDItEUR::L Law::LN Laws of specific jurisdictions and specific areas of law::LNA Legal systems: general"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/178542.2","cover_url":"https://directory.doabooks.org/rest/bitstreams/8c88bf62-4a41-4508-b744-d98dd059c4c2/retrieve","formats":[],"access":"open_access","license":"Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/178542.2","handle":"20.500.12854/178542.2","dspace_uuid":"85b54098-4137-4729-ab08-5edda71fc96e"},"providers":[{"source":"DOAB","source_id":"20.500.12854/178542.2","source_url":"https://directory.doabooks.org/handle/20.500.12854/178542.2","language":"es","formats":[],"access":"open_access","license":"Other open license","verified_legal":true}]},{"id":"work:1740f77a8d433d637f3f319d","title":"El pequeño libro Go","subtitle":"","description":"","authors":["Karl Seguin, `trl.:` Raúl Expósito"],"language":"es","year":null,"publisher":"","isbn":[],"doi":"","subjects":["Programación","Go"],"source":"Free Programming Books","source_url":"https://raulexposito.com/the-little-go-book-en-castellano.html","cover_url":"","formats":[{"type":"pdf","url":"https://raulexposito.com/assets/pdf/go.pdf"},{"type":"epub","url":"https://raulexposito.com/assets/epub/go.epub"},{"type":"html","url":"https://raulexposito.com/the-little-go-book-en-castellano.html"}],"access":"author_free","license":"","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"91a02164483c3f139091","list_url":"https://raw.githubusercontent.com/EbookFoundation/free-programming-books/main/books/free-programming-books-es.md"},"providers":[{"source":"Free Programming Books","source_id":"91a02164483c3f139091","source_url":"https://raulexposito.com/the-little-go-book-en-castellano.html","language":"es","formats":[{"type":"pdf","url":"https://raulexposito.com/assets/pdf/go.pdf"},{"type":"epub","url":"https://raulexposito.com/assets/epub/go.epub"},{"type":"html","url":"https://raulexposito.com/the-little-go-book-en-castellano.html"}],"access":"author_free","license":"","verified_legal":true}]},{"id":"work:fc9ddb60e773f500966fdd0f","title":"El pequeño libro MongoDB","subtitle":"","description":"","authors":["Karl Seguin, `trl.:` Osledy Bazo"],"language":"es","year":null,"publisher":"","isbn":[],"doi":"","subjects":["Programación","MongoDB"],"source":"Free Programming Books","source_url":"https://github.com/uokesita/the-little-mongodb-book","cover_url":"","formats":[],"access":"author_free","license":"","verified_legal":true,"resource_type":"book","identifiers