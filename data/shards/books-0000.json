und Entwicklungswegen der chinesischen Kultur- und Lebensphilosophie im Vergleich zu anderen Kulturen bekannt. Mit Kulturen und deren Philosophien liegt nun endlich auch eine deutsche Übersetzung vor.","authors":["Liang, Shuming"],"language":"de","year":2025,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Neo-Confucianism","Chinese philosophy","Translation","Chinesische Philosophie","Neokonfuzianismus","Übersetzung","thema EDItEUR::Q Philosophy and Religion::QD Philosophy","thema EDItEUR::Q Philosophy and Religion::QD Philosophy::QDH Philosophical traditions and schools of thought","thema EDItEUR::Q Philosophy and Religion::QD Philosophy::QDH Philosophical traditions and schools of thought::QDHR Western philosophy from c 1800","thema EDItEUR::Q Philosophy and Religion::QD Philosophy::QDT Topics in philosophy::QDTS Social and political philosophy"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116907","cover_url":"https://directory.doabooks.org/rest/bitstreams/588d82a4-5423-4df2-8508-f9cb5e9e0e07/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/2ba7fb90-c4ba-45aa-a7eb-7e1c6966804e/retrieve"},{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116907/1/9783110728866.pdf"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116907","handle":"20.500.12854/181480","dspace_uuid":"8c1e44f3-3626-4df6-84d4-31c2ab1265a7","oapen_library_source_id":"20.500.12657/116907","oapen_library_handle":"20.500.12657/116907","oapen_library_dspace_uuid":"8bc278b7-6729-4135-8816-2d2e50e15a26","doab_source_id":"20.500.12854/181480"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116907","source_url":"https://library.oapen.org/handle/20.500.12657/116907","language":"de","formats":[{"type":"pdf","url":"https://library.