e","isbn":["0141970146","3548376509","9780307599803","1846144760","9780241954638","9781846144769","0307744256","9780307744258","0241954630","9788494107603","9783548376509","0307599809","8494107607","9780141970141"],"doi":"","subjects":[],"source":"Open Library","source_url":"https://openlibrary.org/works/OL17785472W","cover_url":"https://covers.openlibrary.org/b/id/8064230-M.jpg","formats":[],"access":"digital_lending","license":"","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"OL17785472W","openlibrary_work":"OL17785472W","openlibrary_edition":"OL38710067M","internet_archive":"ourmathematicalu0000tegm"},"providers":[{"source":"Open Library","source_id":"OL17785472W","source_url":"https://openlibrary.org/works/OL17785472W","language":"es","formats":[],"access":"digital_lending","license":"","verified_legal":true}]},{"id":"work:0ebc2cf7e23c4df93ed9b8e7","title":"Out of the USSR","subtitle":"Travelling Women – Travelling Memories","description":"This book examines how women authors recall their own and their families’ past lives after having emigrated from the Soviet Union in the 1990s, and how they reflect on their new country of residence, be it Germany, Austria, Israel, USA, or Finland, among others. The chapters connect migration, memory, and gender studies to analyse literary presentations created by these \"travelling\" women. The aim of the book is to pay attention both to women’s contribution to cultural transfer, and to the mobility of memories: for the first time, it brings women ’ s narratives as a form and tool to work through both individual and collective traumas to the forefront, remedying a long-standing omission in Russian and post-Soviet migration history. At the same time, the volume looks at \"travelling\" memories and cultural traumas from a gendered perspective: what happens when the recollections of women’s traumatic experiences of Soviet history travel through time and space? As this volume argues, narratives by women who left the Soviet Union often call into question official accounts of Soviet history, and rewrite them in a way that makes room for gendered lived experience.","authors":[],"language":"en","year":2025,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Russian and East European literature(s)","Memory","Transnational mobility","Women’s Writing_x000D_","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism::DSB Literary studies: general","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism","thema EDItEUR::J Society and Social Sciences::JB Society and culture: general::JBS Social groups, communities and identities::JBSF Gender studies, gender groups"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116835","cover_url":"https://library.oapen.org/rest/bitstreams/cba83b8a-52f3-427e-8806-fcca3d3b2cc1/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/7933536d-54db-40ed-bc22-57dfbc8e37f1/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116835","handle":"20.500.12657/116835","dspace_uuid":"910f37f6-3262-456b-bf96-4a3b1da7b6db"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116835","source_url":"https://library.oapen.org/handle/20.500.12657/116835","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/7933536d-54db-40ed-bc22-57dfbc8e37f1/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true}]},{"id":"work:9cac641f7de00a4bdeaee4ad","title":"Out of the USSR","subtitle":"Travelling Women – Travelling Memories","description":"This book examines how women authors recall their own and their families’ past lives after having emigrated from the Soviet Union in the 1990s, and how they reflect on their new country of residence, be it Germany, Austria, Israel, USA, or Finland, among others. The chapters connect migration, memory, and gender studies to analyse literary presentations created by these \"travelling\" women. The aim of the book is to pay attention both to women’s contribution to cultural transfer, and to the mobility of memories: for the first time, it brings women ’ s narratives as a form and tool to work through both individual and collective traumas to the forefront, remedying a long-standing omission in Russian and post-Soviet migration history. At the same time, the volume looks at \"travelling\" memories and cultural traumas from a gendered perspective: what happens when the recollections of women’s traumatic experiences of Soviet history travel through time and space? As this volume argues, narratives by women who left the Soviet Union often call into question official accounts of Soviet history, and rewrite them in a way that makes room for gendered lived experience.","authors":[],"language":"en","year":2025,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Russian and East European literature(s)","Memory","Transnational mobility","Women’s Writing_x000D_","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism::DSB Literary studies: general","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism","thema EDItEUR::J Society and Social Sciences::JB Society and culture: general::JBS Social groups, communities and identities::JBSF Gender studies, gender groups"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/181492","cover_url":"https://directory.doabooks.org/rest/bitstreams/42114220-f749-4dbe-a06e-d06b4411951a/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116835/1/9783111389165.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/181492","handle":"20.500.12854/181492","dspace_uuid":"7bd01ed1-0491-4f2e-89c8-367d858a1a11"},"providers":[{"source":"DOAB","source_id":"20.500.12854/181492","source_url":"https://directory.doabooks.org/handle/20.500.12854/181492","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116835/1/9783111389165.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND","verified_legal":true}]},{"id":"work:82fd8caf6fa1cf6be3aeebf1","title":"Outlines of Abolition Democracy","subtitle":"Black Leftist Writing in 1930s America","description":"This study traces the outlines of democratic theories and practices as they took shape among African American leftists in the 1930s who wrote about the unfinished nature of abolition. Drawing on W.E.B. Du Bois’s framework of abolition democracy, first developed in his 1935 historical study Black Reconstruction , the book explores the resonances of this framework in a range of political writings, organizing efforts, and cultural representations of its time. Through close readings of published and unpublished texts by Du Bois, Richard Wright, Marvel Cooke, William L. Patterson, Louise Thompson, and Langston Hughes, the author argues that African American leftists of the Depression decade articulated radical visions of collective self-determination that would extend the unfinished work of positively substantiating the abolition of racial slavery to encompass comprehensive social, political, and economic transformation. In doing so, the study proposes that these intellectuals and activists laid critical groundwork for abolitionist projects that would develop in the wake of the civil rights movement and in response to an expanding carceral state in the late twentieth and early twenty-first centuries.","authors":["Obst, Anthony"],"language":"en","year":2026,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Abolition","Black Marxism","Great Depression","Abolitionismus","Marxismus","Weltwirtschaftskrise","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism::DSB Literary studies: general::DSBH Literary studies: c 1900 to c 2000","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116911","cover_url":"https://library.oapen.org/rest/bitstreams/1952dde6-c28e-4da7-beef-fd6dbf82ec0b/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/016954e9-3ca2-47a7-97e9-3d47bf2c4312/retrieve"},{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116911/1/9783112218099.pdf"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by/4.0/ · CC-BY · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116911","handle":"20.500.12657/116911","dspace_uuid":"c127b33c-996f-41cc-b4d0-eaddec74f1ac","doab_source_id":"20.500.12854/181582","doab_handle":"20.500.12854/181582","doab_dspace_uuid":"0c3de32b-1487-4c0c-afd6-ea85c8c1fe65"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116911","source_url":"https://library.oapen.org/handle/20.500.12657/116911","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/016954e9-3ca2-47a7-97e9-3d47bf2c4312/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by/4.0/ · CC-BY · Other open license","verified_legal":true},{"source":"DOAB","source_id":"20.500.12854/181582","source_url":"https://directory.doabooks.org/handle/20.500.12854/181582","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116911/1/9783112218099.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by/4.0/ · CC-BY","verified_legal":true}]},{"id":"work:78b99abf5703686748e44fb5","title":"Outward Bound from Liverpool","subtitle":"Reading Malcolm Lowry","description":"Weaving together literary criticism, memoir and place-writing, this book takes the reader on an immersive journey through the landscapes – textual and geographical, remembered and reimagined – of the Wirral-born novelist, poet and short-story writer Malcolm Lowry (1909–57). At the same time, it follows the author’s own evolving engagement with Lowry as she uses him to ‘think with’, turning his texts and her readings of them through unexpected angles, exploring questions of place and belonging, exile and home. Moving through the various terrains of Lowry’s life and work – Liverpool and the Wirral peninsula, where he grew up; Dollarton in British Columbia, where he found his always-threatened idyll; the terrain of the archive; and the richly textured, symbolic landscapes of his writing itself – the book offers a compelling, lyrical and often moving account of a sustained readerly engagement with a writer and what it can enable. At the same time, it pays tribute to the humour, beauty and passion to be found in Lowry’s writing, to his deeply felt sense of place and his prescient concern for the natural world. Outward Bound from Liverpool explores how reading can change us, and shows why Malcolm Lowry is a writer very much worth reading – and re-reading – today.","authors":["Tookey, Helen"],"language":"en","year":2026,"publisher":"Liverpool University Press","isbn":[],"doi":"","subjects":["Merseyside","British Columbia","Place-writing","Ecocriticism","Creative-critical","thema EDItEUR::D Biography, Literature and Literary studies::DN Biography and non-fiction prose::DNC Memoirs","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism::DSK Literary studies: fiction, novelists and prose writers","thema EDItEUR::D Biography, Literature and Literary studies::DS Literature: history and criticism::DSB Literary studies: general::DSBH Literary studies: c 1900 to c 2000","thema EDItEUR::D Biography, Literature and Literary studies::DN Biography and non-fiction prose::DNL Literary essays"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116955","cover_url":"https://library.oapen.org/rest/bitstreams/64d1e481-9273-4168-bbc4-86057e85b65c/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/e630d902-cc12-47ee-a3aa-291b1aa769c3/retrieve"},{"type":"epub","url":"https://library.oapen.org/rest/bitstreams/3c260d3c-eeb0-49ac-82fc-fee50be66f54/retrieve"},{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116955/1/9781836240341.pdf"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116955","handle":"20.500.12657/116955","dspace_uuid":"81edfe7a-e016-4d81-a043-6a807254ea34","doab_source_id":"20.500.12854/181460","doab_handle":"20.500.12854/181460","doab_dspace_uuid":"f3b72a81-da61-47d8-a3a1-0ccd2fedae01"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116955","source_url":"https://library.oapen.org/handle/20.500.12657/116955","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/e630d902-cc12-47ee-a3aa-291b1aa769c3/retrieve"},{"type":"epub","url":"https://library.oapen.org/rest/bitstreams/3c260d3c-eeb0-49ac-82fc-fee50be66f54/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true},{"source":"DOAB","source_id":"20.500.12854/181460","source_url":"https://directory.doabooks.org/handle/20.500.12854/181460","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116955/1/9781836240341.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND","verified_legal":true}]},{"id":"work:201806473e39c91dc69b0d56","title":"Painless Algebra (Painless)","subtitle":"","description":"","authors":["Lynette Long","Lynette Long Ph.D."],"language":"es","year":1998,"publisher":"Barron's","isbn":["9781417756520","9781506268071","9781438007755","9780764134340","9781506268064","1506268064","0764121456","1438007752","1506268072","0764106767","0764181181","9780764181184","1438068247","9780764147159","0764134345","9780764106767","1417756527","9780764121456","9781438068244","0764147153"],"doi":"","subjects":[],"source":"Open Library","source_url":"https://openlibrary.org/works/OL1879491W","cover_url":"https://covers.openlibrary.org/b/id/5006465-M.jpg","formats":[],"access":"digital_lending","license":"","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"OL1879491W","openlibrary_work":"OL1879491W","openlibrary_edition":"OL29882398M","internet_archive":"algebrasindolor0000long"},"providers":[{"source":"Open Library","source_id":"OL1879491W","source_url":"https://openlibrary.org/works/OL1879491W","language":"es","formats":[],"access":"digital_lending","license":"","verified_legal":true}]},{"id":"work:776b89b7c1ef836c2aefdbb1","title":"Pamiri Lifeworlds","subtitle":"Memory and Rupture in Gorno-Badakhshon Autonomous Oblast, Tajikistan","description":"Living through imperial border disputes resulting in the separation of many communities and families, Pamiris find themselves surrounded by rupture, both in memory and contemporary situations in this transborder mountainous region, divided since 1895 by British and Russian imperial border demarcation. This monograph, drawing from ethnographic interviews with Pamiris from Gorno-Badakhshon Autonomous Oblast (GBAO), Tajikistan collected between 2021 and 2023, investigates how Pamiris continue to respond to rupture, using memories of past ruptures to position themselves within their own cartography of Pamir. For some, rupture takes the form of (im)mobility and a fear of coming too close to the border, while others turn to creativity to make sense of the ruptures around them. Through oral narrations and material artefacts, Pamiris learn, feel, and recreate a Pamiri cultural identity which provides continuity in times of rupture, helping younger generations to experience the interconnection of the lifeworld in which they find themselves and, ultimately, imagining Pamir through emotion and memory. This monograph challenges the anthropological assumption that ruptures represent breaks in continuity, arguing that materiality provides continuity in times of instability, with cultural heritage giving Pamiris a way to position themselves in the uncertain present by way of the material turn. In this way, this monograph attempts to draft a Pamiri history of rupture, challenging assumptions of global continuity and relocating historical narratives of the past century to Pamir by presenting Pamiri perspectives on rupture and examining how people remember and respond to times of redirection, uncertainty, and instability. In doing so, this monograph strengthens the growing focus in historical studies on non-elite, marginalised perspectives, for example in the fields of Oral History, Salvage Ethnography, as well as the larger historical debates in the field of Subaltern Studies, ultimately drafting a history of Pamir from a regional perspective. The regional is understood here both spatially and temporally as an overarching perspective, whereby, in contrast to global approaches to space and time, the regional represents part of an inward-outward approach which is distinctive of the New Area Studies. The regional is therefore understood as a perspective which, while existing in relation but not necessarily tied to the geography of Pamir, for example Pamiris living in diaspora in Russia or North America, is in this case a Pamiri experience of being-in-the-world. Drawing from the experiences of Pamiri people articulated using Pamir languages, this book locates such shifts in temporality on a community level, examining how rupture has affected interconnection and understandings of space and time. By shifting to a regional scale, experiences from preconceived peripheries like Pamir are brought to the forefront, highlighting at times the subjectivity of rupture and challenging the concept of the global epoch for the fact that, when you live far from the political centres of nation states or at the vague edges of the mandala, their ruptures lose the relevance a global epoch demands.","authors":["Naeem, Fiona Katherine"],"language":"en","year":2025,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Pamir","Badakhshan","Tajikistan","Cultural Heritage","Kulturelles Erbe","thema EDItEUR::J Society and Social Sciences::JB Society and culture: general::JBC Cultural and media studies::JBCC Cultural studies","thema EDItEUR::J Society and Social Sciences::JB Society and culture: general::JBS Social groups, communities and identities::JBSR Social groups: religious groups and communities","thema EDItEUR::Q Philosophy and Religion::QR Religion and beliefs::QRP Islam"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116868","cover_url":"https://library.oapen.org/rest/bitstreams/98772607-87f5-48a6-ad30-0600c96a4a0c/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/c9f2b14c-c4a3-40b6-88ff-30f60078df4a/retrieve"},{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116868/1/9783112218075.pdf"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116868","handle":"20.500.12657/116868","dspace_uuid":"6dd9de79-a69d-4ef5-bafd-671cca1310d2","doab_source_id":"20.500.12854/181434","doab_handle":"20.500.12854/181434","doab_dspace_uuid":"1e50897b-475d-432a-b2b3-cc5d8b30a741"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116868","source_url":"https://library.oapen.org/handle/20.500.12657/116868","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/c9f2b14c-c4a3-40b6-88ff-30f60078df4a/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true},{"source":"DOAB","source_id":"20.500.12854/181434","source_url":"https://directory.doabooks.org/handle/20.500.12854/181434","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116868/1/9783112218075.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND","verified_legal":true}]},{"id":"work:eb78f79d7a2c1826a43b65fd","title":"Pan-African Aesthetics","subtitle":"Colonial to Postcolonial Struggles for Definitions (1956–2016)","description":"Pan-Africanism has been a global project aiming to unite people of African descent since the late nineteenth century. Notions of Black and African arts and aesthetics have functioned as a bridge and brought positive identification across national, ethnic, or class divides even when rifts have appeared unbridgeable. They were able to mediate Africanity positively, both prior to and during the struggle for liberation and at times when the dream of a unified African nation died. This study explores central aspects, proponents, and opponents of Pan-African aesthetics and shows that conceptualizations of Black, African, and Afrocentric aesthetics form a kaleidoscope that is constantly changing. Based on historical sources, in-depth reading and qualitative interviews, the study illustrates what happened to the discussions in the postcolonial era. The story unfolds along the life paths and approaches of four intellectuals from Anglophone and Francophone Africa. Their framings can tell us more about the underlying themes, contestations, and contradictions of emancipatory projects in the mid-twentieth century and show us that the study of Pan-Africanism is not yet exhausted; neither is the history of the idea and the movement.","authors":["Dallywater, Lena"],"language":"en","year":2026,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Pan-Africanism","Aesthetics","Postcolonialism","Africa","Afrika","Panafrikanismus","Postkolonialismus","Ästhetik","thema EDItEUR::N History and Archaeology::NH History::NHB General and world history","thema EDItEUR::N History and Archaeology::NH History::NHH African history","thema EDItEUR::N History and Archaeology::NH History"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116858","cover_url":"https://library.oapen.org/rest/bitstreams/5c66b125-55a2-4e9f-b96b-14879013a47e/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/0138eb3a-20e5-4f41-a00e-df874e156c67/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by/4.0/ · CC-BY · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116858","handle":"20.500.12657/116858","dspace_uuid":"00cf6a92-9015-46d2-b7f1-4bc908c2469a"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116858","source_url":"https://library.oapen.org/handle/20.500.12657/116858","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/0138eb3a-20e5-4f41-a00e-df874e156c67/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by/4.0/ · CC-BY · Other open license","verified_legal":true}]},{"id":"work:ba1b8934075a87f24eac9b3e","title":"Panoramic and Immersive Media Studies Yearbook","subtitle":"","description":"The PIMS Yearbook is the annual yearbook of the International Panorama Council (IPC, Switzerland). It surveys the historical and contemporary landscape of panoramic and immersive media. Whereas the notion of the panoramic describes extensive, expansive and/or all-embracing vistas, immersion refers to porous interfaces between representation and the real, observer and observed, nature and culture, and past, present, and future. Together, the concepts of panorama and immersion have catalyzed time- and space-bending strategies for creating, experiencing, and transforming culture, ideas, and built and social space across the arc of human history. The PIMS Yearbook presents a range of disciplinary perspectives with the understanding that methodologies in the humanities, the arts, the sciences, design disciplines, social sciences, engineering, and other fi elds contribute important perspectives to the interdisciplinary fi eld of panoramic and immersive media studies. The IPC is the international organization of panorama specialists committed to supporting the heritage and conservation of extant nineteenth and early-twentieth century panoramas, and promoting awareness of the medium’s history, derivative forms, and contemporary iterations. As a non-government and not-for-profit association subject to Swiss law, the IPC is active in the fi elds of panorama research, restoration, financing, management, exhibition, and marketing. The PIMS Yearbook succeeds the International Panorama Council Journal, a selected proceedings of the annual conferences of the IPC, published 2017–2023.","authors":[],"language":"en","year":2025,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Material culture studies","Media archeology","Nineteenth-century popular media","Public history","Materielle Kultur","Medienarchäologie","Populärkultur","thema EDItEUR::A The Arts","thema EDItEUR::A The Arts::AG The Arts: treatments and subjects::AGA History of art","thema EDItEUR::A The Arts::AM Architecture","thema EDItEUR::N History and Archaeology::NH History"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116845","cover_url":"https://library.oapen.org/rest/bitstreams/64c4778a-e130-4bc3-9af6-983ccff72ef1/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/7c88ab81-d1f1-4d21-95c0-8541c6f53d1b/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/116845","handle":"20.500.12657/116845","dspace_uuid":"2cad75d0-95f7-4c27-9d3e-3c2d085c22b3"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/116845","source_url":"https://library.oapen.org/handle/20.500.12657/116845","language":"en","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/7c88ab81-d1f1-4d21-95c0-8541c6f53d1b/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true}]},{"id":"work:b38bb41571f4c102105941e3","title":"Paradise Lost","subtitle":"","description":"","authors":["John Milton"],"language":"ja","year":1667,"publisher":"Borders Classics","isbn":["0820703923","9781557012319","9788573266115","9780872206724","9780582484559","9780023582806","9780872206731","0531004260","1593083645","0872206734","9781573834261","9780521211505","0451527925","048644287X","1554455359","0023582804","9780521057332","0521200679","9780199554225","9780023382352","9780140424393","9780140424263","9780030084805","1573834262","9780521207966","1587263203","0804901732","1554455367","9781841932514","0192833197","1405129298","9781557012203","8854818321","9780665549403","9780665615870","8489715424","9780804901734","8573266112","9780140622447","0375757961","0582484553","9780451527929","0020701705","9781556517273","9781405129299","0665615876","9780393924282","9780665119668","9780404115371","0393924289","9780521200677","0393092305","0340075260","019280619X","9788854818323","087220734X","9781587263200","1595400982","9780393962932","9780582215191","0872206726","9780665549236","002338235X","9780245558825","9780872207349","9781554455355","1557012202","9780451524744","0245558837","0820703931","0393044068","1593080956","019832877X","0899664571","9781595400987","0665549237","0521207967","9780861310227","0333007883","0521082986","0521204577","9781434610843","9780786162338","9781593083649","0872207331","9780340075265","0140424393","155685692X","9780393044065","0861310225","0404115373","1775412288","0451524748","9780820704043","1557012318","9780486442877","9780820703930","9780192833198","9780198319122","0198319126","9781593080952","0393962938","9780333007884","9780841400122","1405832789","9781405129282","9780786148042","0582215196","0841400121","0199554226","9780198328773","9780872207332","9781412168908","9780192806192","0030084806","9788489715424","9780020701705","9781405832786","9781556856921","9780375757969","0820704040","9780820703923","1556517270","0245558829","9781554455362","1412168902","9780521082983","1841932515","9780521204576","0521057337","0786148047","0140622446","1434610845","0521211506","9780582215184","0665549407","9780899664576","9780393092301","0786162333","140512928X","9780531004265","9781775412281","0582215188","0665119666","9780245558832","0140424261"],"doi":"","subjects":[],"source":"Open Library","source_url":"https://openlibrary.org/works/OL810991W","cover_url":"https://covers.openlibrary.org/b/id/5992814-M.jpg","formats":[{"type":"read","url":"https://archive.org/details/paradiselostpoem02miltuoft"}],"access":"open_access","license":"","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"OL810991W","openlibrary_work":"OL810991W","openlibrary_edition":"OL61158732M","internet_archive":"paradiselostpoem02miltuoft"},"providers":[{"source":"Open Library","source_id":"OL810991W","source_url":"https://openlibrary.org/works/OL810991W","language":"ja","formats":[{"type":"read","url":"https://archive.org/details/paradiselostpoem02miltuoft"}],"access":"open_access","license":"","verified_legal":true}]},{"id":"work:6f3551c9f4e23514a4bd21b8","title":"Parlaments- und Behördenbibliotheken im digitalen Wandel","subtitle":"","description":"This volume is intended as an assessment of the situation of the specialized world of parliamentary and public authority libraries. It brings together contributions from libraries of various sizes, sponsors (federal, state) and institutions (parliaments, ministries, courts, authorities) and describes their current challenges as well as their approaches to address them. Its central theme is digital change. How does it affect parliamentary and public authority libraries, which business areas are affected? What adjustments are there, e.g. in acquisitions with regard to print vs. online? Are there any new services being offered in terms of use/customer acquisition and others that have been abolished because there was no longer any demand for them? How do parliamentary and government libraries function in the \"post-COVID\" period, what effects do the home office regulations of the institutions have on the internal organization and the relationship between online vs. face-to-face use? The articles in this volume are based on these and similar key questions. Taken together, they provide an insight into the structural challenges facing parliamentary and public authority libraries and the possibilities for successfully addressing them.","authors":[],"language":"de","year":2026,"publisher":"De Gruyter","isbn":[],"doi":"","subjects":["Library customers","Governmental library","Parliamentary library","Digital transformation","Behördenbibliothek","Parlamentsbibliothek","Digitaler Wandel","Bibliothekskunden","thema EDItEUR::G Reference, Information and Interdisciplinary subjects::GL Library and information sciences / Museology","thema EDItEUR::G Reference, Information and Interdisciplinary subjects::GL Library and information sciences / Museology::GLM Library and information services"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/117066","cover_url":"https://library.oapen.org/rest/bitstreams/6f54f65d-ab86-4b5e-94fa-a71a0bada950/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/7bdcdda7-72a7-4873-9428-8d46928f9a35/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/117066","handle":"20.500.12657/117066","dspace_uuid":"0eac13d3-fcfa-4e3e-a630-d234e913bb18"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/117066","source_url":"https://library.oapen.org/handle/20.500.12657/117066","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/7bdcdda7-72a7-4873-9428-8d46928f9a35/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true}]},{"id":"work:acffec4c6eb7a1ad58d1f0e3","title":"Partizipation damals und heute","subtitle":"Kulturelles Erbe und Identität in historischen und jüdischen Museen und Gedächtniseinrichtungen","description":"Alongside transparency, sustainability, and digitalization, the issue of participation is uniquely influencing the work done by institutions of culture and memory. Museums and memorials are familiar with participation, as they are often founded as the result of citizens’ special engagement. This volume focuses on the collection strategies employed by historical and Jewish museums, and institutions that heavily integrate public participation.","authors":[],"language":"de","year":2025,"publisher":"De Gruyter Oldenbourg","isbn":[],"doi":"","subjects":["Collecting","Museum","Citizen participation","Jewish studies","Bürgerbeteiligung","Judaistik","Sammlung","thema EDItEUR::N History and Archaeology::NH History","thema EDItEUR::G Reference, Information and Interdisciplinary subjects::GL Library and information sciences / Museology::GLC Library, archive and information management","thema EDItEUR::N History and Archaeology::NH History::NHT History: specific events and topics::NHTB Social and cultural history"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/117072","cover_url":"https://library.oapen.org/rest/bitstreams/3601c3ad-a7bd-433e-8a30-5b0a91b1ae6f/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/7317263c-7585-4c7a-b4f7-c6eac53ee274/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/117072","handle":"20.500.12657/117072","dspace_uuid":"063f8118-584c-4bda-b2c6-6a4a0a510e25"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/117072","source_url":"https://library.oapen.org/handle/20.500.12657/117072","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/7317263c-7585-4c7a-b4f7-c6eac53ee274/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true}]},{"id":"work:6cadec337958de64dcc23629","title":"Patrimonio vivo y desarrollo sostenible: una mirada al turismo cultural del Perú","subtitle":"","description":"The book Living Heritage and Sustainable Development: A Perspective on Cultural Tourism in Peru offers an in-depth reflection on the relationship between culture, identity, and sustainability, analyzing how cultural tourism can become a tool for social and economic transformation. From an integrative perspective, it conceives heritage not as a static legacy, but as a living practice that is continuously renewed within Peruvian communities. Across four chapters, the book examines the role of tourism as a cultural mediator, its impact on collective memory, and its capacity to generate inclusive and participatory development models. The work highlights community-based tourism as a sustainable model that promotes hospitality, local autonomy, and solidarity-based economies, showcasing experiences in the Andes, the Amazon, and the coastal regions, where cultural identity becomes a source of well-being. It also presents the country’s main cultural routes, such as the Qhapaq Ñan, Cusco, Puno, and national gastronomy, interpreted as symbolic itineraries that connect tradition, territory, and creativity. Likewise, it recognizes the value of regional expressions such as the Dance of the Negritos of Huánuco, a National Cultural Heritage, and integrated routes such as Kotosh–Tomayquichua–Tingo María, which combine archaeology, tradition, and nature, reflecting the articulation between past and present. The text emphasizes the need for participatory policies, ethical education, and responsible governance that balance conservation and development. Overall, it argues that sustainable cultural tourism is a space for encounter in which heritage acts as a driving force for identity, dignity, and the future of contemporary Peru.","authors":["Lujano-Ortega, Yolanda","Bustinza-Choquehuanca, Sonia Agley","Acero-Ticona, Genoveva","Condori-Pilco, Lucio Bernardo","Flores-Aroni, Bertha Juana","Achata-Cortez, César Augusto"],"language":"es","year":2026,"publisher":"Sophia Editions","isbn":[],"doi":"10.64092/nffe9961","subjects":["Turismo cultural","Patrimonio cultural","Desarrollo sostenible","Turismo comunitario","Identidad cultural","thema EDItEUR::J Society and Social Sciences"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/178501.2","cover_url":"https://directory.doabooks.org/rest/bitstreams/1a00cf25-ad93-491d-bf21-55828ae94136/retrieve","formats":[],"access":"open_access","license":"Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/178501.2","handle":"20.500.12854/178501.2","dspace_uuid":"cb1fe1bc-5398-4ab3-8604-c8e64b34b4d7"},"providers":[{"source":"DOAB","source_id":"20.500.12854/178501.2","source_url":"https://directory.doabooks.org/handle/20.500.12854/178501.2","language":"es","formats":[],"access":"open_access","license":"Other open license","verified_legal":true}]},{"id":"work:4bd8c7b3cd3995e639695577","title":"Paul Clifford — Complete","subtitle":"","description":"","authors":["Lytton, Edward Bulwer Lytton, Baron"],"language":"en","year":null,"publisher":"Project Gutenberg","isbn":[],"doi":"","subjects":["Brigands and robbers -- Fiction","Category: British Literature","Category: Crime, Thrillers and Mystery","Category: Novels"],"source":"Project Gutenberg","source_url":"https://www.gutenberg.org/ebooks/7735","cover_url":"https://www.gutenberg.org/cache/epub/7735/pg7735.cover.medium.jpg","formats":[{"type":"html","url":"https://www.gutenberg.org/ebooks/7735.html.images"},{"type":"epub","url":"https://www.gutenberg.org/ebooks/7735.epub3.images"},{"type":"mobi","url":"https://www.gutenberg.org/ebooks/7735.kf8.images"},{"type":"text","url":"https://www.gutenberg.org/ebooks/7735.txt.utf-8"},{"type":"text","url":"https://www.gutenberg.org/files/7735/7735-0.txt"}],"access":"public_domain","license":"Public domain in the United States","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"7735","gutenberg_id":"7735"},"providers":[{"source":"Project Gutenberg","source_id":"7735","source_url":"https://www.gutenberg.org/ebooks/7735","language":"en","formats":[{"type":"html","url":"https://www.gutenberg.org/ebooks/7735.html.images"},{"type":"epub","url":"https://www.gutenberg.org/ebooks/7735.epub3.images"},{"type":"mobi","url":"ht