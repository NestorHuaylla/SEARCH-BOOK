sis for every compound shown in the work.","authors":[],"language":"en","year":2026,"publisher":"IntechOpen","isbn":[],"doi":"10.5772/intechopen.115666","subjects":["Genetics","Medical genetics","thema EDItEUR::M Medicine and Nursing::MF Pre-clinical medicine: basic sciences::MFN Medical genetics"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/181618","cover_url":"https://directory.doabooks.org/rest/bitstreams/c69efca1-096b-415e-a615-ce0d327ba8d9/retrieve","formats":[],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc/4.0/ · CC-BY-NC","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/181618","handle":"20.500.12854/181618","dspace_uuid":"d294f117-99ab-4173-a461-ae9a2a36c089"},"providers":[{"source":"DOAB","source_id":"20.500.12854/181618","source_url":"https://directory.doabooks.org/handle/20.500.12854/181618","language":"en","formats":[],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc/4.0/ · CC-BY-NC","verified_legal":true}]},{"id":"work:9592a0a55c5a6cce7622cecd","title":"Nimio De Anquin, De Las 2 Inhabitaciones En El Hombre","subtitle":"","description":"","authors":["Nimio de Anquin"],"language":"es","year":1978,"publisher":"","isbn":[],"doi":"","subjects":["Filosofía \"Tomista\""],"source":"Internet Archive","source_url":"https://archive.org/details/nimio-de-anquin-de-las-2-inhabitaciones-en-el-hombre","cover_url":"https://archive.org/services/img/nimio-de-anquin-de-las-2-inhabitaciones-en-el-hombre","formats":[],"access":"creative_commons","license":"https://creativecommons.org/publicdomain/mark/1.0/","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"nimio-de-anquin-de-las-2-inhabitaciones-en-el-hombre","internet_archive":"nimio-de-anquin-de-las-2-inhabitaciones-en-el-hombre"},"providers":[{"source":"Internet Archive","source_id":"nimio-de-anquin-de-las-2-inhabitaciones-en-el-hombre","source_url":"https://