tEUR::C Language and Linguistics::CF Linguistics::CFG Semantics, discourse analysis, stylistics","thema EDItEUR::G Reference, Information and Interdisciplinary subjects::GT Interdisciplinary studies::GTC Communication studies","thema EDItEUR::C Language and Linguistics::CF Linguistics"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/181583","cover_url":"https://directory.doabooks.org/rest/bitstreams/76e3f18e-95ce-4828-b9e1-e5b20c681a41/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116671/1/9783111692067.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by/4.0/ · CC-BY","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/181583","handle":"20.500.12854/181583","dspace_uuid":"60065349-749b-4116-b7bb-178d0deca0a6"},"providers":[{"source":"DOAB","source_id":"20.500.12854/181583","source_url":"https://directory.doabooks.org/handle/20.500.12854/181583","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116671/1/9783111692067.pdf"}],"access":"creative_commons","license":"open access · https://creativecommons.org/licenses/by/4.0/ · CC-BY","verified_legal":true}]},{"id":"work:9523f60c342b76af8d660da9","title":"Kurdisches Leben in Deutschland","subtitle":"Eine (un-)sichtbare Realität zwischen Rassismus, Marginalisierung und (Nicht-)Anerkennung","description":"Kurd:innen finden in diskriminierungskritischen Diskursen wenig Beachtung. Obwohl sie eine der zahlenmäßig größten Zuwanderungsgruppen in Deutschland darstellen, ist kaum etwas darüber bekannt, dass antikurdischer Rassismus weit verbreitet ist. Um dies zu ändern, beleuchten renommierte Wissenschaftler:innen das Themenfeld aus verschiedenen Perspektiven: Was entsteht, sind gebündelte Diskursbeiträge, die für die spezifische Situation von Kurd:innen sensibilisieren und das fachliche Engagement gegen Rassismus stärken. Es sind starke Stimmen, die dazu dienen, das spezifische Phänomen der kurdischen Rassismus- und Diskriminierungserfahrung im Gesamtkontext von Marginalisierung, Dethematisierung, Intersektionalität und Nicht-Anerkennung in Deutschland sichtbar zu machen.","authors":[],"language":"de","year":2026,"publisher":"Beltz Juventa","isbn":[],"doi":"10.3262/978-3-7799-9162-5","subjects":["Soziale Arbeit","Intersektionalität","Diskriminierung","Kurden","Kurd:innen","Kurdistan","Kurden in Deutschland","Diskriminierung von Kurden","Kurdische Community","Rassismus in Deutschland","Marginalisierung von Kurden","Kurdische Migration","Antikurdischer Rassismus","Rassismuserfahrungen von Kurd*innen","Jugendhilfe","Jugendarbeit","Sprache","Mehrsprachigkeit","Migration","thema EDItEUR::J Society and Social Sciences::JB Society and culture: general::JBF Social and ethical issues::JBFA Social discrimination and social justice::JBFA1 Racism and racial discrimination / Anti-racism","thema EDItEUR::J Society and Social Sciences::JB Society and culture: general::JBF Social and ethical issues::JBFB Social Integration and assimilation","thema EDItEUR::J Society and Social Sciences::JB Society and culture: general::JBF Social and ethical issues::JBFA Social discrimination and social justice","thema EDItEUR::J Society and Social Sciences::JB Society and culture: general::JBF Social and ethical issues"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/117049","cover_url":"https://library.oapen.org/rest/bitstreams/5725b4b3-aa85-4a63-98bd-678f59e9cbda/retrieve","formats":[],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/117049","handle":"20.500.12657/117049","dspace_uuid":"8d4b20fa-a20b-4a5c-a49d-7f7e810e35c7"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/117049","source_url":"https://library.oapen.org/handle/20.500.12657/117049","language":"de","formats":[],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND","verified_legal":true}]},{"id":"work:71525233f3f6a13b56a5d1fa","title":"L'île mystérieuse","subtitle":"","description":"","authors":["Verne, Jules"],"language":"fr","year":null,"publisher":"Project Gutenberg","isbn":[],"doi":"","subjects":["Adventure stories","Castaways -- Fiction","Islands of the Pacific -- Fiction","Science fiction","Category: Adventure","Category: Classics of Literature","Category: Novels","Category: Science-Fiction & Fantasy","FR Littérature","FR Science fiction"],"source":"Project Gutenberg","source_url":"https://www.gutenberg.org/ebooks/14287","cover_url":"https://www.gutenberg.org/cache/epub/14287/pg14287.cover.medium.jpg","formats":[{"type":"html","url":"https://www.gutenberg.org/ebooks/14287.html.images"},{"type":"epub","url":"https://www.gutenberg.org/ebooks/14287.epub3.images"},{"type":"mobi","url":"https://www.gutenberg.org/ebooks/14287.kf8.images"},{"type":"text","url":"https://www.gutenberg.org/ebooks/14287.txt.utf-8"},{"type":"text","url":"https://www.gutenberg.org/files/14287/14287-0.txt"}],"access":"public_domain","license":"Public domain in the United States","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"14287","gutenberg_id":"14287"},"providers":[{"source":"Project Gutenberg","source_id":"14287","source_url":"https://www.gutenberg.org/ebooks/14287","language":"fr","formats":[{"type":"html","url":"https://www.gutenberg.org/ebooks/14287.html.images"},{"type":"epub","url":"https://www.gutenberg.org/ebooks/14287.epub3.images"},{"type":"mobi","url":"https://www.gutenberg.org/ebooks/14287.kf8.images"},{"type":"text","url":"https://www.gutenberg.org/ebooks/14287.txt.utf-8"},{"type":"text","url":"https://www.gutenberg.org/files/14287/14287-0.txt"}],"access":"public_domain","license":"Public domain in the United States","verified_legal":true}]},{"id":"work:f2b7c1fdd09a55d02397a288","title":"L’umorismo tra sacro e profano : attualità e prospettive di ricerca","subtitle":"","description":"Engaging in a critical dialogue with traditional interpretations of the sacred, theologians, linguists, historians, and philosophers have been invited to reconstruct the fabric of the delicate relationship between humour and transcendence and characterize laughter as a two-way catalyst in the relationship between humanity and God. The essays collected in this volume prove that laughter and humour are not marginal or subversive elements in relation to the sacred, but are instead capable of shedding light on the relationship between the human and the divine. From the «God who laughs»—gleaned from comparisons with the ancient world—to humour as the language of friendship between God and humankind, and on to the modern rediscovery of comic elements in the Bible, a common thread emerges: laughter as a cognitive tool. In contemporary multimodal texts—queer representations of the divine or cinematic reworkings that play with the conventions of orthodoxy—humour proves to be the most effective tool for destabilizing hierarchies, challenging gender norms, and redefining the contemporary religious imagination. Throughout the essays, the comic does not negate the sacred: it questions, transforms, and opens it to new spaces of meaning—inclusive and dialogic— acting not only as a key to understanding the relationships that humans maintain with the transcendent, but also as an interpretive framework for the meanings and tensions that characterize our existence.","authors":[],"language":"it","year":2026,"publisher":"FedOA - Federico II University Press","isbn":[],"doi":"10.6093/978-88-6887-423-0","subjects":["Sacred, Profane, Religion, interdisciplinary approach, Humour","thema EDItEUR::D Biography, Literature and Literary studies"],"source":"DOAB","source_url":"https://directory.doabooks.org/handle/20.500.12854/181627","cover_url":"https://directory.doabooks.org/rest/bitstreams/4c3e081c-02be-4042-99ed-9db432fea893/retrieve","formats":[{"type":"read","url":"https://www.fedoabooks.unina.it/index.php/fedoapress/it/catalog/book/820"}],"access":"open_access","license":"All rights reserved","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12854/181627","handle":"20.500.12854/181627","dspace_uuid":"6f6e8cde-10b9-43c6-961f-b377c11f0cc3"},"providers":[{"source":"DOAB","source_id":"20.500.12854/181627","source_url":"https://directory.doabooks.org/handle/20.500.12854/181627","language":"it","formats":[{"type":"read","url":"https://www.fedoabooks.unina.it/index.php/fedoapress/it/catalog/book/820"}],"access":"open_access","license":"All rights reserved","verified_legal":true}]},{"id":"work:4cf64a8d0f11a26eedf9b4bd","title":"La charca del diablo","subtitle":"","description":"","authors":["George Sand"],"language":"fr","year":1846,"publisher":"Gallimard","isbn":["9782277231943","9782723425964","9781414241029","2010095987","9781976339202","9781434639547","1406538531","9782010095986","9781843911050","9780320064081","2290314129","1843911051","9781406538533","1976339200","0320064085","0080037348","9782744404559","2277231940","1435335007","9781406800340","9780318634890","1414258879","2090319739","9782266030694","9782070368921","8871003985","2723425967","9781419159145","1435335171","9782090319736","9781414241012","1419159143","2070368920","1434639541","9781414258775","1414241011","9782290314128","9782011678423","2744404551","9781414258874","2011678420","9788871003986","9781435335004","9781435335172","141424102X","1414258771","9780080037349","1406800341","2266030698","0318634899"],"doi":"","subjects":[],"source":"Open Library","source_url":"https://openlibrary.org/works/OL982018W","cover_url":"https://covers.openlibrary.org/b/id/8413404-M.jpg","formats":[{"type":"read","url":"https://archive.org/details/devilspool00sand"}],"access":"open_access","license":"","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"OL982018W","openlibrary_work":"OL982018W","openlibrary_edition":"OL54882101M","internet_archive":"devilspool00sand"},"providers":[{"source":"Open Library","source_id":"OL982018W","source_url":"https://openlibrary.org/works/OL982018W","language":"fr","formats":[{"type":"read","url":"https://archive.org/details/devilspool00sand"}],"access":"open_access","license":"","verified_legal":true}]},{"id":"work:7466042c7f5b9185d840dd39","title":"La formación de recursos humanos en informática en las universidades argentinas","subtitle":"","description":"","authors":["Hector Ricardo Gertel"],"language":"es","year":1987,"publisher":"Secretaría de Ciencia y Técnica, Subsecretaría de Informática y Desarrollo","isbn":[],"doi":"","subjects":[],"source":"Open Library","source_url":"https://openlibrary.org/works/OL11529625W","cover_url":"","formats":[],"access":"metadata_only","license":"","verified_legal":false,"resource_type":"book","identifiers":{"source_id":"OL11529625W","openlibrary_work":"OL11529625W","openlibrary_edition":"OL57875367M"},"providers":[{"source":"Open Library","source_id":"OL11529625W","source_url":"https://openlibrary.org/works/OL11529625W","language":"es","formats":[],"access":"metadata_only","license":"","verified_legal":false}]},{"id":"work:6fc627b94a7254f712ba227f","title":"La Guía de Estilos de Ruby","subtitle":"","description":"","authors":["Ale Mohamad"],"language":"es","year":null,"publisher":"","isbn":[],"doi":"","subjects":["Programación","Ruby"],"source":"Free Programming Books","source_url":"https://github.com/alemohamad/ruby-style-guide/blob/master/README-esLA.md","cover_url":"","formats":[],"access":"author_free","license":"","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"35681b3d76db487c0b13","list_url":"https://raw.githubusercontent.com/EbookFoundation/free-programming-books/main/books/free-programming-books-es.md"},"providers":[{"source":"Free Programming Books","source_id":"35681b3d76db487c0