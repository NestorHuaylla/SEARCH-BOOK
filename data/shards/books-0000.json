y.org/works/OL259026W","cover_url":"https://covers.openlibrary.org/b/id/7420452-M.jpg","formats":[{"type":"read","url":"https://archive.org/details/bwb_O8-BXS-912"}],"access":"open_access","license":"","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"OL259026W","openlibrary_work":"OL259026W","openlibrary_edition":"OL59173515M","internet_archive":"bwb_O8-BXS-912"},"providers":[{"source":"Open Library","source_id":"OL259026W","source_url":"https://openlibrary.org/works/OL259026W","language":"es","formats":[{"type":"read","url":"https://archive.org/details/bwb_O8-BXS-912"}],"access":"open_access","license":"","verified_legal":true}]},{"id":"work:4638d3eb58a9f098b44cae3e","title":"Kirche und Israel // Church and Israel","subtitle":"","description":"The document Church and Israel is regarded as the first endeavour by European Reformation churches to define a common position on the relationship between Christians and Jews. It offers analyses of the biblical foundations and historical development of the relationship between the Church and Israel, discusses previous attempts to clarify the difficult relationship and finally develops its own definition of this relationship. It concludes with practical recommendations on considering Judaism in theology and the church, and a call to take joint responsibility for the world. The document was adopted in 2001 by the General Assembly of the Community of Protestant Churches in Europe and is reprinted without change in this new edition. It is supplemented by a report of the conference held to evaluate its reception 10 years later, in 2011, and by two assessments of the study presented on that occasion by Peter Scherle and Micha Brumlik.","authors":[],"language":"de","year":2021,"publisher":"Evangelische Verlagsanstalt","isbn":[],"doi":"10.36199/978-3-374-06814-2","subjects":["Judaism","Dialogue","The Old Testament","Anti-Semitism","Dabru Emet","thema EDItEUR::Q Philosophy and Religion::QR Religion and beliefs::QRV Aspects of religion::QRVG Theology","thema EDItEUR::Q Philosophy and Religion::QR Religion and beliefs::QRM Christianity","thema EDItEUR::Q Philosophy and Religion::QR Religion and beliefs::QRJ Judaism"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/117083","cover_url":"https://library.oapen.org/rest/bitstreams/a18c4be9-746e-4e77-a84f-081d69421c67/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/9452e950-7c4d-4091-b0dc-5eb39ef1a5ee/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/117083","handle":"20.500.12657/117083","dspace_uuid":"aff77cdc-054f-4475-939d-b61331a70e10"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/117083","source_url":"https://library.oapen.org/handle/20.500.12657/117083","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/9452e950-7c4d-4091-b0dc-5eb39ef1a5ee/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true}]},{"id":"work:24af97c786e61b0de1e9888f","title":"Kirchengemeinschaft | Church Communion","subtitle":"","description":"Church communion – communio has become a key concept in ecclesiological deliberations in ecumenical contexts. This volume presents the result of a doctrinal conversation, adopted by the General Assembly of the CPCE in 2018, evaluating the church communion realised on the basis of the Leuenberg Agreement since its signing in 1973 and specifying the theological concept of church communion in the light of the latest ecumenical discussions. In addition, it contemplates the challenges that the CPCE currently faces as a communion of churches in Europe and suggests potential approaches to further intensifying this communion. This volume also contains a reprint of a previously scarcely available text revealing key considerations prior to the conclusion of the Leuenberg Agreement, which provides an invaluable tool for understanding this model of church fellowship.","authors":[],"language":"de","year":2019,"publisher":"Evangelische Verlagsanstalt","isbn":[],"doi":"10.36199/978-3-374-06241-6","subjects":["Ecumenism","Denominations","Catholicity","Commitment","Unity of the Church","Schism","The Leuenberg Agreement","thema EDItEUR::Q Philosophy and Religion::QR Religion and beliefs::QRM Christianity::QRMB Christian Churches, denominations, groups","thema EDItEUR::Q Philosophy and Religion::QR Religion and beliefs::QRM Christianity"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/117084","cover_url":"https://library.oapen.org/rest/bitstreams/0bc3861a-975d-4afd-93c8-65c91450f09a/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/42888dea-5b36-4071-98f9-157319731752/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"20.500.12657/117084","handle":"20.500.12657/117084","dspace_uuid":"980b27f7-4f47-4763-abe8-fe8b4fb0a3d1"},"providers":[{"source":"OAPEN Library","source_id":"20.500.12657/117084","source_url":"https://library.oapen.org/handle/20.500.12657/117084","language":"de","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/42888dea-5b36-4071-98f9-157319731752/retrieve"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/ · CC-BY-NC-ND · Other open license","verified_legal":true}]},{"id":"work:555631a6cc32679344e34906","title":"KM 14.02.17","subtitle":"","description":"","authors":["Martino Di Pierro"],"language":"es","year":2017,"publisher":"","isbn":[],"doi":"","subjects":["streaming"],"source":"Internet Archive","source_url":"https://archive.org/details/KM14.02.17","cover_url":"https://archive.org/services/img/KM14.02.17","formats":[],"access":"creative_commons","license":"http://creativecommons.org/publicdomain/mark/1.0/","verified_legal":true,"resource_type":"book","identifiers":{"source_id":"KM14.02.17","internet_archive":"KM14.02.17"},"providers":[{"source":"Internet Archive","source_id":"KM14.02.17","source_url":"https://archive.org/details/KM14.02.17","language":"es","formats":[],"access":"creative_commons","license":"http://creativecommons.org/publicdomain/mark/1.0/","verified_legal":true}]},{"id":"work:6ba1bd45b0206468cda36354","title":"Konstruktive Auslegung mechanisch zu fügender Strukturen am Beispiel des Clinchens artgleicher Materialien","subtitle":"","description":"Die stetige Entwicklung ressourceneffizienter und nachhaltiger Leichtbaukonzepte erfordert heutzutage oftmals den Einsatz wandlungsfähiger Fertigungstechnologien. Insbesondere beim Fügen von Multi-Material-Kombinationen kommen etablierte Verfahren wie das Schweißen gegenwärtig oftmals an deren Grenzen. Mechanische Fügetechnologien, wie das Clinchen oder Nieten bieten hier eine leistungsfähige Alternative. Sollen Baugruppen im Rahmen einer Produktentwicklung für ein definiertes Anforderungsprofil ausgelegt werden, fehlen jedoch oft Standards und Merkblätter, auf welche Konstrukteure zurückgreifen können. Aus diesem Grund fokussiert die vorliegende Arbeit die Erforschung eines Vorgehensmodells zur konstruktiven Auslegung mechanisch zu fügender Strukturen. Mittels wissensbasierter und datengetriebener Methoden soll der Produktentwickler von der initialen Aufgabenerfassung bis hin zur Erzeugung erster Produktentwürfe konstruktionsbegleitend unterstützt werden. Dies umfasst neben dem Training maschineller Lernverfahren vor allem den Aufbau einer rechnerverarbeitbaren Wissensbasis. Entsprechend lassen sich bereits vor der finalen Produktausarbeitung wichtige Rückschlüsse zur Anforderungserfüllung und Fügbarkeit einer Konstruktion ziehen. Durch die Implementierung eines wissensbasierten Assistenzsystems lässt sich zudem die Übertragbarkeit der entwickelten Methoden in ein digitales System überprüfen und deren Anwendung anhand einer exemplarischen Fügeaufgabe demonstrieren. Stellvertretend für den Bereich der mechanischen Fügeverfahren steht demnach die Auslegung einer Clinchverbindung unter Berücksichtigung artgleicher Werkstoff-Dicken-Kombinationen und quasi-statischer Lasteinwirkungen im Fokus. Zusammenfassend leistet die vorliegende Arbeit einen grundlegenden Beitrag für die konstruktive Auslegung mechanisch zu fügender Strukturen. Durch den dargestellten Ansatz wird der Konstrukteur bereits in den frühen Phasen der Produktentwicklung unterstützt und der Weg hin zu hochwertigen Erstentwürfen nach dem ”First-Time-Right\"-Prinzip geebnet.","authors":["Zirngibl, Christoph"],"language":"de","year":2026,"publisher":"FAU University Press","isbn":[],"doi":"10.25593/978-3-96147-909-2","subjects":["Konstruktion","Produktentwicklung","Maschinelles Lernen","Finite-Elemente-Methode","Fügeverfahren","Assistenzsystem","Statistische Versuchsplanung","thema EDItEUR::T Technology, Engineering, Agriculture, Industrial processes::TG Mechanical engineering and materials::TGB Mechanical engineering","thema EDItEUR::T Technology, Engineering, Agriculture, Industrial processes::TG Mechanical engineering and materials::TGP Production and industrial engineering"],"source":"OAPEN Library","source_url":"https://library.oapen.org/handle/20.500.12657/116943","cover_url":"https://library.oapen.org/rest/bitstreams/adb5a718-993e-4dcd-b477-9d63f7f0d9a1/retrieve","formats":[{"type":"pdf","url":"https://library.oapen.org/rest/bitstreams/2d673219-4e06-42d3-bd25-a6f63c0e69db/retrieve"},{"type":"pdf","url":"https://library.oapen.org/bitstream/20.500.12657/116943/1/9783961479092.pdf"}],"access":"creative_commons","license":"https://creativecommons.org/licenses/by-nc/4.0/ · CC-BY-NC · Other